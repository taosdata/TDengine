{
  "filetype": "insert",
  "cfgdir": "/etc/taos",
  "host": "127.0.0.1",
  "port": 6030,
  "rest_port": 6041,
  "user": "root",
  "password": "taosdata",
  "thread_count": 40,
  "create_table_thread_count": 40,
  "result_file": "/root/taosBenchmark_result.log",
  "confirm_parameter_prompt": "no",
  "insert_interval": 0,
  "num_of_records_per_req": 10000,
  "max_sql_len": 1024000,
  "databases": [
    {
      "dbinfo": {
        "name": "stream_test",
        "drop": "no",
        "replica": 1,
        "duration": 10,
        "precision": "ms",
        "keep": 3650,
        "minRows": 100,
        "maxRows": 4096,
        "comp": 2,
        "vgroups": 10,
        "stt_trigger": 1
      },
      "super_tables": [
        {
          "name": "stb",
          "child_table_exists": "yes",
          "childtable_count": 1000,
          "childtable_prefix": "ctb0_",
          "escape_character": "no",
          "auto_create_table": "no",
          "batch_create_tbl_num": 1000,
          "data_source": "rand",
          "insert_mode": "taosc",
          "rollup": null,
          "interlace_rows": 400,
          "line_protocol": null,
          "tcp_transfer": "no",
          "insert_rows": 5000000,
          "partial_col_num": 0,
          "childtable_limit": 0,
          "childtable_offset": 0,
          "rows_per_tbl": 0,
          "max_sql_len": 1024000,
          "disorder_ratio": 0,
          "disorder_range": 1000,
          "keep_trying": 0,
          "timestamp_step": 1000,
          "trying_interval": 0,
          "start_timestamp": "2021-01-01 00:00:00",
          "sample_format": "csv",
          "sample_file": "./sample.csv",
          "tags_file": "",
          "columns": [
            {"type": "INT", "count": 1},
            {"type": "FLOAT", "count": 2},
            {"type": "TIMESTAMP", "count": 1}
          ],
          "tags": [
            {"type": "TINYINT", "count": 1},
            {"type": "BINARY", "count": 1, "len": 16}
          ]
        }
      ]
    }
  ],
  "prepare_rand": 10000,
  "chinese": "no",
  "streams": [
    {
      "stream_name": "interval_stream_stability",
      "stream_stb": "stream_test.output_streamtb_interval",
      "trigger_mode": "at_once",
      "watermark": "30s",
      "subtable": "(concat(\"sub_tb1_\", \"suffix\"))",
      "fill_history": "1",
      "ignore_update": "0",
      "ignore_expired": "0",
      "stream_stb_field": "(ts,c1,c2,c3)",
      "stream_tag_field": "(t1)",
      "source_sql": "select _wstart as wstart, min(c1),max(c2), count(c3)  from stream_test.stb interval(10s)",
      "drop": "yes"
    },
    {
      "stream_name": "session_stream_stability",
      "stream_stb": "stream_test.output_streamtb_session",
      "trigger_mode": "at_once",
      "watermark": "30s",
      "subtable": "(concat(\"sub_tb1_\", \"suffix\"))",
      "fill_history": "1",
      "ignore_update": "0",
      "ignore_expired": "0",
      "stream_stb_field": "(ts,c1,c2,c3)",
      "stream_tag_field": "(t1)",
      "source_sql": "select _wstart as wstart, min(c1),max(c2), count(c3)  from stream_test.stb session(ts, 1s)",
      "drop": "yes"
    },
    {
      "stream_name": "state_stream_stability",
      "stream_stb": "stream_test.output_streamtb_state",
      "trigger_mode": "at_once",
      "watermark": "30s",
      "subtable": "(concat(\"sub_tb1_\", \"suffix\"))",
      "fill_history": "1",
      "ignore_update": "0",
      "ignore_expired": "0",
      "stream_stb_field": "(ts,c1,c2,c3)",
      "stream_tag_field": "(t1)",
      "source_sql": "select _wstart as wstart, min(c1),max(c2), count(c3)  from stream_test.stb partition by tbname t1 state_window(c0)",
      "drop": "yes"
    },
    {
      "stream_name": "event_stream_stability",
      "stream_stb": "stream_test.output_streamtb_event",
      "trigger_mode": "at_once",
      "watermark": "30s",
      "subtable": "(concat(\"sub_tb1_\", \"suffix\"))",
      "fill_history": "1",
      "ignore_update": "0",
      "ignore_expired": "0",
      "stream_stb_field": "(ts,c1,c2,c3)",
      "stream_tag_field": "(t1)",
      "source_sql": "select _wstart as wstart, min(c1),max(c2), count(c3)  from stream_test.stb partition by tbname t1 event_window start with c0 >= 100 and c1 < 200 end with c0 < 1000 or c1 >= 500 ",
      "drop": "yes"
    }
  ],
  "test_log": "/root/testlog/"
}
