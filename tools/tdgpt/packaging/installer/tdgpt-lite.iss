; TDGPT Lite Windows Installer Script
; Generated by win_release.py. This template deliberately contains no model
; resource, model venv, mirror, or model-selection handling.

#define MyAppName "{{APP_NAME}}"
#define MyLegacyAppName "{{LEGACY_APP_NAME}}"
#define MyAppPublisher "taosdata"
#define MyAppURL "http://www.taosdata.com/"
#define MyAppVersion "{{VERSION}}"
#define MyAppInstallName "{{PACKAGE_NAME}}"
#define MyAppInstallDir "C:\TDengine\taosanode"
#define MyAppSourceDir "{{SOURCE_DIR}}"
#define MyAppIco "{{ICON_FILE}}"

[Setup]
AppId={{a77a678d-8806-48a5-8017-1d55749b6895}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppMutex=Global\TDengine-TDgpt-Setup
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
DefaultDirName={#MyAppInstallDir}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputDir={{OUTPUT_DIR}}
OutputBaseFilename={#MyAppInstallName}
SetupIconFile={#MyAppIco}
UninstallDisplayIcon={app}\favicon.ico
Compression=lzma
SolidCompression=yes
CloseApplications=no
DisableDirPage=yes
Uninstallable=yes
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
SetupLogging=yes
ExtraDiskSpaceRequired=2147483648

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "{#MyAppIco}"; DestDir: "{app}"; DestName: "favicon.ico"; Flags: ignoreversion
Source: "{#MyAppSourceDir}\cfg\*"; DestDir: "{app}\cfg"; Flags: ignoreversion recursesubdirs createallsubdirs onlyifdoesntexist uninsneveruninstall
Source: "{#MyAppSourceDir}\lib\*"; DestDir: "{app}\lib"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppSourceDir}\model\*"; DestDir: "{app}\model"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "{#MyAppSourceDir}\requirements\*"; DestDir: "{app}\requirements"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppSourceDir}\python\*"; DestDir: "{app}\python"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "{#MyAppSourceDir}\bin\*"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "{#MyAppSourceDir}\install.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppSourceDir}\install.py"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppSourceDir}\uninstall.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppSourceDir}\uninstall.py"; DestDir: "{app}"; Flags: ignoreversion

[Dirs]
Name: "{app}\cfg"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\log"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\model"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\model_venvs"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\venvs"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\data"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\data\pids"; Permissions: everyone-modify; Flags: uninsneveruninstall
Name: "{app}\data\resource"; Permissions: everyone-modify; Flags: uninsneveruninstall

[Run]
Filename: "notepad.exe"; Parameters: """{app}\log\install.log"""; Description: "View the installation log now (clear this checkbox to skip opening it)"; Flags: postinstall nowait skipifsilent

[UninstallRun]
Filename: "{cmd}"; Parameters: "/C call ""{app}\uninstall.bat"""; Flags: runhidden waituntilterminated

[InstallDelete]
; TDgpt Lite replaces both earlier Lite and full TDgpt shortcut sets.
Name: "{commonprograms}\{#MyAppName}"; Type: filesandordirs
Name: "{commonprograms}\{#MyLegacyAppName}"; Type: filesandordirs
Name: "{commondesktop}\Start Taosanode.lnk"; Type: files
Name: "{app}\resource"; Type: filesandordirs

[Registry]
Root: HKLM; Subkey: "Software\taosdata\TDgpt"; ValueType: string; ValueName: "InstallDir"; ValueData: "{app}"; Flags: uninsdeletevalue uninsdeletekeyifempty
Root: HKLM; Subkey: "Software\taosdata\TDgpt"; ValueType: string; ValueName: "Version"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletevalue uninsdeletekeyifempty

[Code]
const
  PostInstallTimeoutMilliseconds = 45 * 60 * 1000;
  InstallMetadataKey = 'Software\taosdata\TDgpt';
  ServiceRegistryKey = 'SYSTEM\CurrentControlSet\Services\Taosanode';

var
  OfflinePackagePage: TInputFileWizardPage;
  InstallProgressPage: TOutputProgressWizardPage;
  FinishNotesLabel: TNewStaticText;
  PostInstallCompleted: Boolean;
  LockedInstallDir: String;
  LockedInstallSource: String;

procedure ExitProcess(ExitCode: Integer);
  external 'ExitProcess@kernel32.dll stdcall';

function GetTickCount(): Cardinal;
  external 'GetTickCount@kernel32.dll stdcall';

procedure LogTdgpt(MessageText: String);
begin
  Log('[TDgpt-Lite] ' + MessageText);
end;

function NormalizeDir(Value: String): String;
begin
  Result := RemoveBackslashUnlessRoot(Trim(Value));
end;

function ExtractExecutablePath(CommandLine: String): String;
var
  Value: String;
  EndQuote: Integer;
  SpacePos: Integer;
begin
  Value := Trim(CommandLine);
  Result := '';
  if Value = '' then exit;
  if Value[1] = '"' then
  begin
    Delete(Value, 1, 1);
    EndQuote := Pos('"', Value);
    if EndQuote > 0 then
      Result := Copy(Value, 1, EndQuote - 1)
    else
      Result := Value;
    exit;
  end;
  SpacePos := Pos(' ', Value);
  if SpacePos > 0 then
    Result := Copy(Value, 1, SpacePos - 1)
  else
    Result := Value;
end;

function ResolveLockedInstallDir(var ErrorMessage: String): Boolean;
var
  MetadataDir: String;
  ServiceImagePath: String;
  ServiceDir: String;
begin
  ErrorMessage := '';
  LockedInstallDir := '';
  LockedInstallSource := '';
  MetadataDir := '';
  ServiceDir := '';
  if RegQueryStringValue(HKEY_LOCAL_MACHINE, InstallMetadataKey, 'InstallDir', MetadataDir) then
    MetadataDir := NormalizeDir(MetadataDir);
  if RegQueryStringValue(HKEY_LOCAL_MACHINE, ServiceRegistryKey, 'ImagePath', ServiceImagePath) then
    ServiceDir := NormalizeDir(ExtractFileDir(ExtractFileDir(ExtractExecutablePath(ServiceImagePath))));
  if (MetadataDir <> '') and (ServiceDir <> '') and
    (CompareText(MetadataDir, ServiceDir) <> 0) then
  begin
    ErrorMessage :=
      'An inconsistent {#MyAppName} installation state was detected.' + #13#10 +
      'Registry install directory: ' + MetadataDir + #13#10 +
      'Taosanode service directory: ' + ServiceDir + #13#10 +
      'Uninstall or repair the existing installation before continuing.';
    Result := False;
    exit;
  end;
  if MetadataDir <> '' then
  begin
    LockedInstallDir := MetadataDir;
    LockedInstallSource := 'registry';
  end
  else if ServiceDir <> '' then
  begin
    LockedInstallDir := ServiceDir;
    LockedInstallSource := 'service';
  end;
  Result := True;
end;

procedure EnforceLockedInstallDir();
var
  RequestedDir: String;
  MessageText: String;
begin
  if LockedInstallDir = '' then exit;
  RequestedDir := NormalizeDir(ExpandConstant('{param:DIR|}'));
  if RequestedDir = '' then
  begin
    WizardForm.DirEdit.Text := LockedInstallDir;
    exit;
  end;
  if CompareText(RequestedDir, LockedInstallDir) = 0 then exit;
  MessageText :=
    'This machine already has {#MyAppName} installed.' + #13#10 +
    'Existing install directory: ' + LockedInstallDir + #13#10 +
    'Requested install directory: ' + RequestedDir + #13#10 +
    'To install into a different directory, uninstall the existing installation first.';
  LogTdgpt(MessageText);
  if not WizardSilent() then
    MsgBox(MessageText, mbCriticalError, MB_OK);
  ExitProcess(1);
end;

function IsUninstallerFileName(FileName: String): Boolean;
begin
  Result := (Length(FileName) = 12) and
    (CompareText(Copy(FileName, 1, 5), 'unins') = 0) and
    (FileName[6] >= '0') and (FileName[6] <= '9') and
    (FileName[7] >= '0') and (FileName[7] <= '9') and
    (FileName[8] >= '0') and (FileName[8] <= '9') and
    ((CompareText(Copy(FileName, 9, 4), '.exe') = 0) or
      (CompareText(Copy(FileName, 9, 4), '.dat') = 0));
end;

procedure RemoveStaleUninstallFiles();
var
  FindRec: TFindRec;
  TargetDir: String;
  CurrentExe: String;
  CurrentDat: String;
  Candidate: String;
begin
  TargetDir := ExpandConstant('{app}');
  if not DirExists(TargetDir) then
    exit;
  CurrentExe := ExtractFileName(ExpandConstant('{uninstallexe}'));
  CurrentDat := ChangeFileExt(CurrentExe, '.dat');
  if not FindFirst(AddBackslash(TargetDir) + 'unins*.*', FindRec) then
    exit;
  try
    repeat
      Candidate := FindRec.Name;
      if IsUninstallerFileName(Candidate) and
        (CompareText(Candidate, CurrentExe) <> 0) and
        (CompareText(Candidate, CurrentDat) <> 0) then
      begin
        if DeleteFile(AddBackslash(TargetDir) + Candidate) then
          LogTdgpt('Removed stale uninstaller file: ' + Candidate)
        else
          LogTdgpt('Could not remove stale uninstaller file: ' + Candidate);
      end;
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
end;

function FindPackage(BaseDir: string; Pattern: string): string;
var
  FindRec: TFindRec;
begin
  Result := '';
  if not FindFirst(AddBackslash(BaseDir) + Pattern, FindRec) then exit;
  try
    Result := AddBackslash(BaseDir) + FindRec.Name;
  finally
    FindClose(FindRec);
  end;
end;

function DetectDefaultOfflinePackage(): string;
var
  SearchDir: string;
begin
  Result := '';
  SearchDir := ExtractFileDir(ExpandConstant('{srcexe}'));
  if SearchDir = '' then exit;
  Result := FindPackage(SearchDir, 'tdengine-tdgpt-lite-venv-*-windows-x64.zip');
  if Result <> '' then exit;
  Result := FindPackage(SearchDir, 'tdengine-tdgpt-venv-*-windows-x64.zip');
end;

procedure PopulateOfflinePackage();
begin
  if ExpandConstant('{param:OFFLINE|}') <> '' then
    OfflinePackagePage.Values[0] := ExpandConstant('{param:OFFLINE|}')
  else
    OfflinePackagePage.Values[0] := DetectDefaultOfflinePackage();
end;

function ValidateRuntime(): Boolean;
var
  RuntimeDir: string;
begin
  RuntimeDir := Trim(ExpandConstant('{param:PYTHON_RUNTIME_DIR|}'));
  Result := (RuntimeDir = '') or FileExists(AddBackslash(RuntimeDir) + 'python.exe');
  if not Result and not WizardSilent() then
    MsgBox('The supplied Python runtime does not contain python.exe:' + #13#10 + RuntimeDir, mbCriticalError, MB_OK);
end;

function InitializeSetup(): Boolean;
var
  ErrorMessage: String;
begin
  Result := ResolveLockedInstallDir(ErrorMessage);
  if not Result then
  begin
    LogTdgpt(ErrorMessage);
    if not WizardSilent() then
      MsgBox(ErrorMessage, mbCriticalError, MB_OK);
    exit;
  end;
  Result := ValidateRuntime();
  if not Result then LogTdgpt('Invalid /PYTHON_RUNTIME_DIR parameter');
end;

function RunCommandCapture(CmdLine: String; var OutputText: AnsiString): Boolean;
var
  ResultCode: Integer;
  TempFile: String;
  CmdArgs: String;
begin
  TempFile := ExpandConstant('{tmp}\tdgpt-lite-command-output.txt');
  DeleteFile(TempFile);
  CmdArgs := '/C ' + CmdLine + ' > "' + TempFile + '" 2>&1';
  Result := Exec(ExpandConstant('{cmd}'), CmdArgs, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  OutputText := '';
  if FileExists(TempFile) then
  begin
    LoadStringFromFile(TempFile, OutputText);
    DeleteFile(TempFile);
  end;
  OutputText := Trim(OutputText);
  Result := Result and (ResultCode = 0);
end;

function ServiceExists(ServiceName: String): Boolean;
var
  OutputText: AnsiString;
begin
  RunCommandCapture('sc query "' + ServiceName + '"', OutputText);
  Result := Pos('SERVICE_NAME:', Uppercase(OutputText)) > 0;
end;

function IsServiceStopped(ServiceName: String): Boolean;
var
  OutputText: AnsiString;
  UpperText: String;
begin
  RunCommandCapture('sc query "' + ServiceName + '"', OutputText);
  UpperText := Uppercase(OutputText);
  Result := (Pos('FAILED 1060', UpperText) > 0) or
    ((Pos('STATE', UpperText) > 0) and (Pos('STOPPED', UpperText) > 0));
end;

function WaitForServiceStop(ServiceName: String; TimeoutSeconds: Integer): Boolean;
var
  Attempt: Integer;
begin
  for Attempt := 0 to TimeoutSeconds * 2 do
  begin
    if IsServiceStopped(ServiceName) then
    begin
      Result := True;
      exit;
    end;
    Sleep(500);
  end;
  Result := IsServiceStopped(ServiceName);
end;

function WaitForFileUnlock(FilePath: String; TimeoutSeconds: Integer): Boolean;
var
  Attempt: Integer;
  TempPath: String;
begin
  if not FileExists(FilePath) then
  begin
    Result := True;
    exit;
  end;

  TempPath := FilePath + '.tdgpt-check';
  if FileExists(TempPath) then
    DeleteFile(TempPath);
  for Attempt := 0 to TimeoutSeconds * 2 do
  begin
    if RenameFile(FilePath, TempPath) then
    begin
      RenameFile(TempPath, FilePath);
      Result := True;
      exit;
    end;
    Sleep(500);
  end;
  Result := False;
end;

function GetExistingServiceManagerPython(TargetDir: String): String;
var
  CandidatePath: String;
  ResultCode: Integer;
begin
  Result := '';
  CandidatePath := AddBackslash(TargetDir) + 'venvs\venv\Scripts\python.exe';
  if FileExists(CandidatePath) and
    Exec(CandidatePath, '--version', TargetDir, SW_HIDE, ewWaitUntilTerminated, ResultCode) and
    (ResultCode = 0) then
  begin
    Result := CandidatePath;
    exit;
  end;
  CandidatePath := AddBackslash(TargetDir) + 'python\runtime\python.exe';
  if FileExists(CandidatePath) and
    Exec(CandidatePath, '--version', TargetDir, SW_HIDE, ewWaitUntilTerminated, ResultCode) and
    (ResultCode = 0) then
    Result := CandidatePath;
end;

procedure StopExistingModelServices(TargetDir: String);
var
  ResultCode: Integer;
  PythonExe: String;
  ServiceScript: String;
begin
  ServiceScript := AddBackslash(TargetDir) + 'bin\taosanode_service.py';
  if not FileExists(ServiceScript) then
    exit;
  PythonExe := GetExistingServiceManagerPython(TargetDir);
  if PythonExe = '' then
  begin
    LogTdgpt('No usable Python found for graceful model shutdown.');
    exit;
  end;
  LogTdgpt('Stopping existing model workers.');
  Exec(PythonExe, '"' + ServiceScript + '" model-stop all', TargetDir,
    SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure KillProcessByPidFile(PidFilePath: String);
var
  ResultCode: Integer;
  PidText: AnsiString;
begin
  if (not FileExists(PidFilePath)) or (not LoadStringFromFile(PidFilePath, PidText)) then
    exit;
  PidText := Trim(PidText);
  if PidText <> '' then
    Exec(ExpandConstant('{cmd}'), '/C taskkill /F /T /PID ' + PidText + ' >nul 2>&1',
      '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure KillProcessesFromPidDir(PidDir: String);
var
  FindRec: TFindRec;
begin
  if (not DirExists(PidDir)) or (not FindFirst(AddBackslash(PidDir) + '*.pid', FindRec)) then
    exit;
  try
    repeat
      KillProcessByPidFile(AddBackslash(PidDir) + FindRec.Name);
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
end;

function EscapePowerShellSingleQuoted(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '''', '''''', True);
end;

function GetInstallTreeProcessSummary(TargetDir: String): String;
var
  OutputText: AnsiString;
  PowerShellExe: String;
  PowerShellCommand: String;
  CmdLine: String;
begin
  Result := '';
  PowerShellExe := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellExe) then
    exit;
  PowerShellCommand :=
    '$procs = Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -like ''' +
    EscapePowerShellSingleQuoted(AddBackslash(TargetDir) + '*') +
    ''' }; ' +
    'if ($procs) { ' +
    '$procs | Select-Object -First 10 @{Name=''Info'';Expression={ $_.Name + '' PID='' + $_.ProcessId + '' EXE='' + $_.ExecutablePath }} | ' +
    'ForEach-Object { $_.Info } ' +
    '}';
  CmdLine := '""' + PowerShellExe + '" -NoProfile -ExecutionPolicy Bypass -Command "' + PowerShellCommand + '""';
  RunCommandCapture(CmdLine, OutputText);
  Result := Trim(OutputText);
end;

function BuildLockedFileMessage(TargetDir: String; LockedPath: String): String;
var
  ProcessSummary: String;
begin
  Result := 'TDgpt Lite cannot update a file still in use:' + #13#10 + #13#10 + LockedPath + #13#10 + #13#10;
  ProcessSummary := GetInstallTreeProcessSummary(TargetDir);
  if ProcessSummary <> '' then
    Result := Result + 'Processes still running under the install directory:' + #13#10 +
      ProcessSummary + #13#10 + #13#10;
  Result := Result + 'Stop the Taosanode service and related Python processes, then retry.';
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode: Integer;
  TargetDir: String;
  WinSWPath: String;
  RuntimePythonPath: String;
  RuntimeDllPath: String;
  ProcessSummary: String;
begin
  Result := '';
  TargetDir := ExpandConstant('{app}');
  if (not DirExists(TargetDir)) and (not ServiceExists('Taosanode')) then
    exit;

  LogTdgpt('Stopping existing Taosanode service before upgrade.');
  if ServiceExists('Taosanode') then
  begin
    Exec(ExpandConstant('{cmd}'), '/C sc stop Taosanode >nul 2>&1', '', SW_HIDE,
      ewWaitUntilTerminated, ResultCode);
    if not WaitForServiceStop('Taosanode', 15) then
      LogTdgpt('Taosanode service did not stop gracefully; forcing process cleanup.');
  end;

  StopExistingModelServices(TargetDir);
  KillProcessByPidFile(AddBackslash(TargetDir) + 'taosanode.pid');
  KillProcessesFromPidDir(AddBackslash(TargetDir) + 'data\pids');
  WinSWPath := AddBackslash(TargetDir) + 'bin\taosanode-winsw.exe';
  if FileExists(WinSWPath) then
    Exec(WinSWPath, 'stop', TargetDir, SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Exec(ExpandConstant('{cmd}'), '/C taskkill /F /T /IM taosanode-winsw.exe >nul 2>&1',
    '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

  if ServiceExists('Taosanode') and (not WaitForServiceStop('Taosanode', 15)) then
  begin
    Result := 'The Taosanode service did not stop before the upgrade.';
    exit;
  end;
  if not WaitForFileUnlock(WinSWPath, 15) then
  begin
    Result := BuildLockedFileMessage(TargetDir, WinSWPath);
    exit;
  end;
  RuntimePythonPath := AddBackslash(TargetDir) + 'python\runtime\python.exe';
  if not WaitForFileUnlock(RuntimePythonPath, 15) then
  begin
    Result := BuildLockedFileMessage(TargetDir, RuntimePythonPath);
    exit;
  end;
  RuntimeDllPath := AddBackslash(TargetDir) + 'python\runtime\python3.dll';
  if not WaitForFileUnlock(RuntimeDllPath, 15) then
  begin
    Result := BuildLockedFileMessage(TargetDir, RuntimeDllPath);
    exit;
  end;
  ProcessSummary := GetInstallTreeProcessSummary(TargetDir);
  if ProcessSummary <> '' then
    Result := 'TDgpt Lite processes are still running:' + #13#10 + #13#10 + ProcessSummary;
end;

procedure InitializeWizard();
begin
  EnforceLockedInstallDir();
  PostInstallCompleted := False;
  OfflinePackagePage := CreateInputFilePage(
    wpWelcome,
    'TDGPT Lite offline venv',
    'Select the TDGPT Lite main venv package',
    'TDGPT Lite imports only its main venv. Models and model runtimes are loaded separately after installation.');
  OfflinePackagePage.Add('Lite main venv package:', 'ZIP archives|*.zip|All files|*.*', '.zip');
  PopulateOfflinePackage();

  InstallProgressPage := CreateOutputProgressPage(
    'Installing {#MyAppName}',
    'Preparing the Lite Python environment and registering the Windows service');

  FinishNotesLabel := TNewStaticText.Create(WizardForm.FinishedPage);
  FinishNotesLabel.Parent := WizardForm.FinishedPage;
  FinishNotesLabel.Left := WizardForm.FinishedLabel.Left;
  FinishNotesLabel.Top := WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(6);
  FinishNotesLabel.Width := ScaleX(420);
  FinishNotesLabel.Height := ScaleY(110);
  FinishNotesLabel.AutoSize := False;
  FinishNotesLabel.WordWrap := True;
  FinishNotesLabel.Visible := False;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if CurPageID = OfflinePackagePage.ID then
  begin
    if Trim(OfflinePackagePage.Values[0]) = '' then
    begin
      MsgBox('Select a TDGPT Lite main venv ZIP package.', mbError, MB_OK);
      Result := False;
    end
    else if not FileExists(OfflinePackagePage.Values[0]) then
    begin
      MsgBox('The selected TDGPT Lite main venv package does not exist.', mbError, MB_OK);
      Result := False;
    end;
  end;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (PageID = OfflinePackagePage.ID) and WizardSilent();
end;

function GetInstallFlags(): String;
var
  RuntimeDir: String;
begin
  Result := '-o --offline-package ' + AddQuotes(Trim(OfflinePackagePage.Values[0])) + ' --model-source none';
  RuntimeDir := Trim(ExpandConstant('{param:PYTHON_RUNTIME_DIR|}'));
  if RuntimeDir <> '' then
    Result := '--python-runtime-dir ' + AddQuotes(RuntimeDir) + ' ' + Result;
end;

procedure ShowInstallFailureAndAbort(TitleValue: String; DetailValue: String);
begin
  LogTdgpt('Installation failure: ' + TitleValue + ' | ' + DetailValue);
  if not WizardSilent() then
    MsgBox(TitleValue + #13#10 + #13#10 + DetailValue + #13#10 + #13#10 +
      'Log file: ' + ExpandConstant('{app}\log\install.log'), mbCriticalError, MB_OK);
  ExitProcess(1);
end;

function TryParseProgressLine(LineValue: String; var StatusValue: String; var PercentValue: Integer;
  var TitleValue: String; var DetailValue: String): Boolean;
var
  Pos1, Pos2, Pos3: Integer;
  Rest: String;
begin
  Result := False;
  Pos1 := Pos('|', LineValue);
  if Pos1 = 0 then exit;
  StatusValue := Copy(LineValue, 1, Pos1 - 1);
  Rest := Copy(LineValue, Pos1 + 1, MaxInt);
  Pos2 := Pos('|', Rest);
  if Pos2 = 0 then exit;
  PercentValue := StrToIntDef(Copy(Rest, 1, Pos2 - 1), -1);
  Rest := Copy(Rest, Pos2 + 1, MaxInt);
  Pos3 := Pos('|', Rest);
  if (PercentValue < 0) or (Pos3 = 0) then exit;
  TitleValue := Copy(Rest, 1, Pos3 - 1);
  DetailValue := Copy(Rest, Pos3 + 1, MaxInt);
  Result := True;
end;

function ReadLatestProgressEntry(ProgressFile: String; var StatusValue: String; var PercentValue: Integer;
  var TitleValue: String; var DetailValue: String): Boolean;
var
  RawText: AnsiString;
  Content, LineValue: String;
  BreakPos: Integer;
  I: Integer;
begin
  Result := False;
  if not LoadStringFromFile(ProgressFile, RawText) then exit;
  Content := Trim(RawText);
  StringChangeEx(Content, #13#10, #10, True);
  StringChangeEx(Content, #13, #10, True);
  while Content <> '' do
  begin
    BreakPos := 0;
    for I := Length(Content) downto 1 do
    begin
      if Content[I] = #10 then
      begin
        BreakPos := I;
        break;
      end;
    end;
    if BreakPos > 0 then
    begin
      LineValue := Copy(Content, BreakPos + 1, MaxInt);
      Content := Trim(Copy(Content, 1, BreakPos - 1));
    end
    else
    begin
      LineValue := Content;
      Content := '';
    end;
    if TryParseProgressLine(LineValue, StatusValue, PercentValue, TitleValue, DetailValue) then
    begin
      Result := True;
      exit;
    end;
  end;
end;

procedure WaitForPostInstall();
var
  ResultCode, PercentValue: Integer;
  ProgressFile, CmdArgs, StatusValue, TitleValue, DetailValue: String;
  StartedAt: Cardinal;
begin
  ProgressFile := ExpandConstant('{app}\log\install-progress.log');
  DeleteFile(ProgressFile);
  InstallProgressPage.SetProgress(0, 100);
  InstallProgressPage.Show;
  WizardForm.CancelButton.Enabled := False;
  try
    CmdArgs := '/C set "TDGPT_PROGRESS_FILE=' + ProgressFile + '" && call "' +
      ExpandConstant('{app}\install.bat') + '" ' + GetInstallFlags();
    if not Exec(ExpandConstant('{cmd}'), CmdArgs, '', SW_HIDE, ewNoWait, ResultCode) then
      ShowInstallFailureAndAbort('Installation failed', 'Unable to launch install.bat.');
    StartedAt := GetTickCount();
    while True do
    begin
      if ReadLatestProgressEntry(ProgressFile, StatusValue, PercentValue, TitleValue, DetailValue) then
      begin
        InstallProgressPage.SetText(TitleValue, DetailValue);
        InstallProgressPage.SetProgress(PercentValue, 100);
        if StatusValue = 'success' then break;
        if StatusValue = 'error' then ShowInstallFailureAndAbort(TitleValue, DetailValue);
      end;
      if GetTickCount() - StartedAt >= PostInstallTimeoutMilliseconds then
        ShowInstallFailureAndAbort('Installation timed out',
          'The post-install helper did not report a final result. See install.log for details.');
      Sleep(400);
    end;
  finally
    InstallProgressPage.Hide;
    WizardForm.CancelButton.Enabled := True;
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then
  begin
    WizardForm.FinishedHeadingLabel.Caption := '{#MyAppName} installation completed';
    FinishNotesLabel.Caption := 'Lite main venv: ' + Trim(OfflinePackagePage.Values[0]) + #13#10 +
      'Models are not installed by this package.' + #13#10 +
      'Installation log: ' + ExpandConstant('{app}\log\install.log') + #13#10 +
      'Service status: ' + ExpandConstant('{app}\bin\status-taosanode.bat');
    FinishNotesLabel.Visible := True;
  end
  else
    FinishNotesLabel.Visible := False;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if (CurStep = ssPostInstall) and (not PostInstallCompleted) then
  begin
    PostInstallCompleted := True;
    WaitForPostInstall();
  end;
  if CurStep = ssDone then
    RemoveStaleUninstallFiles();
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if (CurUninstallStep = usPostUninstall) and FileExists(ExpandConstant('{app}\taosanode.pid')) then
    DeleteFile(ExpandConstant('{app}\taosanode.pid'));
end;
