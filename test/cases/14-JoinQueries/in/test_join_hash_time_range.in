USE hash_join_snap;

EXPLAIN SELECT a.ts, a.device, b.metric FROM (SELECT ts, device, MAX(val) AS val FROM l_norm WHERE ts >= '2025-01-01 00:00:01.000' AND ts <= '2025-01-01 00:00:02.000' GROUP BY ts, device) a JOIN (SELECT ts, device, MAX(metric) AS metric FROM r_norm WHERE ts >= '2025-01-01 00:00:01.000' AND ts <= '2025-01-01 00:00:02.000' GROUP BY ts, device) b ON a.ts = b.ts \G;

