USE join_condition_relaxation;

SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v > b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v >= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v > a.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v >= a.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v < a.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v <= a.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v + 1 < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v + 1 <= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v - 1 > b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON ABS(a.v) < ABS(b.v) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON CAST(a.v AS BIGINT) <= CAST(b.v AS BIGINT) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON LENGTH(a.name) < LENGTH(b.name) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts < b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts <= b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts > b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts >= b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts + 1s < b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts - 1s >= b.ts ORDER BY 1, 2;

SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v < b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v < b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v < b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v < b.v ORDER BY 1;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v <= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v <= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v <= b.v ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v <= b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v <= b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v <= b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v <= b.v ORDER BY 1;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v > b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v > b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v > b.v ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v > b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v > b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v > b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v > b.v ORDER BY 1;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v >= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v >= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v >= b.v ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v >= b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v >= b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v >= b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v >= b.v ORDER BY 1;

SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v AND a.grp = b.grp ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <= b.v AND a.id < b.id ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v > b.v AND LOWER(a.name) = LOWER(b.name) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v >= b.v AND a.lo <= b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v < b.v AND b.id <= 12 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v < b.v WHERE b.id <= 12 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v < b.v AND a.id >= 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v < b.v WHERE a.id IS NULL OR b.id IS NULL ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v WHERE a.grp = 1 AND b.grp <= 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v AND a.grp = b.grp WHERE a.id <= 4 ORDER BY 1, 2;

SELECT a.id, b.id FROM (SELECT * FROM l_range WHERE id <= 3) a JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN (SELECT * FROM r_range WHERE id <= 13) b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT id, v FROM l_range WHERE v IS NOT NULL) a JOIN (SELECT id, v FROM r_range WHERE v IS NOT NULL) b ON a.v <= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT DISTINCT id, v FROM l_range) a JOIN (SELECT DISTINCT id, v FROM r_range) b ON a.v > b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT id, MAX(v) v FROM l_range GROUP BY id) a JOIN (SELECT id, MAX(v) v FROM r_range GROUP BY id) b ON a.v >= b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT id, v FROM l_range ORDER BY id DESC LIMIT 3) a LEFT JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN (SELECT id, v FROM r_range ORDER BY id LIMIT 3) b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT * FROM l_range WHERE 1 = 0) a FULL JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN (SELECT * FROM r_range WHERE 1 = 0) b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id, c.id FROM (l_range a JOIN r_range b ON a.v < b.v) JOIN l_range c ON c.v <= b.v ORDER BY 1, 2, 3;

SELECT a.id, b.id, a.v, b.v, b.v - a.v FROM l_range a JOIN r_range b ON a.v < b.v ORDER BY 1, 2;
SELECT a.id, b.id, a.ts, b.ts, TIMEDIFF(b.ts, a.ts) FROM l_range a JOIN r_range b ON a.ts < b.ts ORDER BY 1, 2;
SELECT DISTINCT a.id FROM l_range a JOIN r_range b ON a.v < b.v ORDER BY 1;
SELECT a.id, COUNT(*), MIN(b.id), MAX(b.id) FROM l_range a JOIN r_range b ON a.v < b.v GROUP BY a.id ORDER BY 1;
SELECT b.id, COUNT(*), SUM(a.id) FROM l_range a JOIN r_range b ON a.v < b.v GROUP BY b.id ORDER BY 1;
SELECT COUNT(*), SUM(a.id), SUM(b.id) FROM l_range a JOIN r_range b ON a.v < b.v;
SELECT a.id, COUNT(*) FROM l_range a JOIN r_range b ON a.v <= b.v GROUP BY a.id HAVING COUNT(*) > 1 ORDER BY 1;
SELECT CASE WHEN a.v < 0 THEN 'negative' ELSE 'nonnegative' END, COUNT(*) FROM l_range a JOIN r_range b ON a.v < b.v GROUP BY CASE WHEN a.v < 0 THEN 'negative' ELSE 'nonnegative' END ORDER BY 1;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v ORDER BY 1 DESC, 2 DESC LIMIT 3;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v ORDER BY 1, 2 LIMIT 3 OFFSET 2;

SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v BETWEEN b.lo AND b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v BETWEEN a.lo AND a.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v >= b.lo AND a.v <= b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.lo <= b.hi AND b.lo <= a.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON ABS(TIMEDIFF(a.ts, b.ts)) <= 2s ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.ts >= b.ts - 1s AND a.ts <= b.ts + 2s ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.ts >= a.ts AND b.ts < a.ts + 3s ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.hi <= b.lo AND b.lo - a.hi <= 2 ORDER BY 1, 2;

SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v AND a.grp + 1 = b.grp ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.ts < b.ts AND a.grp = b.grp ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.ts <= b.ts AND a.grp = b.grp ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.ts > b.ts AND a.grp = b.grp ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.ts >= b.ts AND a.grp = b.grp ORDER BY 1;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v + 1 < b.v WHERE a.grp <= 2 OR (a.grp IS NULL AND b.grp <= 2) ORDER BY 1, 2;
