USE join_condition_relaxation;

SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v = 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v = 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v = 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v = 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON b.v > 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON b.v > 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON b.v > 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON b.v > 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON 1 = 1 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON 1 = 1 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON 1 = 1 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON 1 = 1 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON 1 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON 1 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON 1 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON 1 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a RIGHT JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v <> b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v <> b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v <> b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v <> b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v < b.v OR a.grp = b.grp ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON NOT (a.v < b.v) ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v = 2 ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v = 2 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v = 2 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v = 2 ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON b.v > 0 ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON b.v > 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON b.v > 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON b.v > 0 ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON 1 = 1 ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON 1 = 1 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON 1 = 1 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON 1 = 1 ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON 1 = 0 ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON 1 = 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON 1 = 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON 1 = 0 ORDER BY 1;


SELECT a.id, b.id FROM l_range a JOIN r_range b WHERE a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b WHERE a.v = b.v OR a.ts = b.ts ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b WHERE a.id <= 2 ORDER BY 1, 2;
SELECT a.id, b.id, c.id FROM l_range a JOIN r_range b JOIN r_range c WHERE a.v = b.v AND b.id = c.id ORDER BY 1, 2, 3;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1;
SELECT a.id FROM l_range a LEFT SEMI JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT SEMI JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON (a.v + b.v) % 2 = 0 ORDER BY 1;

SELECT a.id, b.id, a.v + b.v FROM l_range a JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id, a.v * b.v FROM l_range a JOIN r_range b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <> b.v WHERE a.grp <= 2 AND b.grp <= 2 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON a.v = 2 WHERE b.id IS NULL OR b.id <= 13 ORDER BY 1, 2;
SELECT a.id, COUNT(*), MIN(b.id), MAX(b.id) FROM l_range a JOIN r_range b ON a.v <> b.v GROUP BY a.id ORDER BY 1;
SELECT b.id, COUNT(*), SUM(a.id) FROM l_range a JOIN r_range b ON a.v < b.v OR a.grp = b.grp GROUP BY b.id ORDER BY 1;
SELECT COUNT(*), SUM(a.id), SUM(b.id) FROM l_range a JOIN r_range b ON 1 = 1;
SELECT COUNT(*), SUM(a.id), SUM(b.id) FROM l_range a JOIN r_range b ON 1 = 0;
SELECT a.id, b.id FROM (SELECT * FROM l_range WHERE id <= 3) a JOIN r_range b ON a.v <> b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a JOIN (SELECT * FROM r_range WHERE id >= 13) b ON NOT (a.v < b.v) ORDER BY 1, 2;
SELECT DISTINCT a.id FROM l_range a JOIN r_range b ON b.v > 0 ORDER BY 1;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <> b.v ORDER BY 1 DESC, 2 DESC LIMIT 5;
SELECT a.id, b.id FROM l_range a JOIN r_range b ON a.v <> b.v ORDER BY 1, 2 LIMIT 5 OFFSET 3;
SELECT CASE WHEN a.v IS NULL THEN 'null' ELSE 'value' END, COUNT(*) FROM l_range a JOIN r_range b ON 1 = 1 GROUP BY CASE WHEN a.v IS NULL THEN 'null' ELSE 'value' END ORDER BY 1;
SELECT a.id, b.id FROM (SELECT DISTINCT id, v, grp FROM l_range) a FULL JOIN (SELECT DISTINCT id, v, grp, hi FROM r_range) b ON a.grp <> b.grp OR a.v = b.v ORDER BY 1, 2;
SELECT a.id, b.id FROM (SELECT id, MAX(v) v FROM l_range GROUP BY id) a JOIN (SELECT id, MAX(v) v, MAX(hi) hi FROM r_range GROUP BY id) b ON a.v * b.v < b.hi ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a FULL JOIN r_range b ON 1 = 0 ORDER BY 1, 2;
SELECT a.id, b.id FROM l_range a LEFT JOIN r_range b ON 1 = 1 ORDER BY 1, 2;
SELECT a.id FROM l_range a LEFT ANTI JOIN r_range b ON 1 = 1 ORDER BY 1;
SELECT b.id FROM l_range a RIGHT ANTI JOIN r_range b ON 1 = 0 ORDER BY 1;
