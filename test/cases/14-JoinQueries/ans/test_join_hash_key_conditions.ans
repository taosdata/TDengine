taos> SELECT a.payload FROM l_key_ext a LEFT ANTI JOIN r_key_ext b ON a.k_geometry = b.k_geometry AND a.payload < b.metric ORDER BY 1;
   payload   |
==============
         103 |
         104 |

taos> SELECT a.k_bool, COUNT(*), SUM(a.payload), SUM(b.metric) FROM l_key a JOIN r_key b ON a.k_bool = b.k_bool AND a.k_bin = b.k_bin WHERE b.metric >= 20 PARTITION BY a.k_bool ORDER BY 1;
 k_bool |       count(*)        |    sum(a.payload)     |     sum(b.metric)     |
=================================================================================
 false  |                     1 |                     2 |                    20 |
 true   |                     2 |                    12 |                   121 |

taos> SELECT a.k_varchar, COUNT(*), SUM(a.payload), SUM(b.metric) FROM l_key_ext a JOIN r_key_ext b ON a.k_varchar = b.k_varchar AND a.k_varbinary = b.k_varbinary WHERE b.metric >= 200 PARTITION BY a.k_varchar ORDER BY 1;
       k_varchar        |       count(*)        |    sum(a.payload)     |     sum(b.metric)     |
=================================================================================================
 varchar_a              |                     1 |                   101 |                   201 |
 varchar_b              |                     1 |                   102 |                   202 |

taos> SELECT a.payload, b.metric FROM l_key a JOIN r_key b ON a.k_int = b.k_int AND (a.payload < b.metric OR a.k_bool = b.k_bool) ORDER BY 1, 2;
   payload   |   metric    |
============================
           1 |          10 |
           3 |          30 |
           4 |          40 |
           6 |          60 |
           6 |          61 |

taos> SELECT a.payload, b.metric FROM l_key a JOIN r_key b ON a.k_int = b.k_int AND (a.payload < b.metric AND a.k_bool = b.k_bool) ORDER BY 1, 2;
   payload   |   metric    |
============================
           1 |          10 |
           3 |          30 |
           6 |          60 |
           6 |          61 |

taos> SELECT a.payload, b.metric FROM l_key_ext a JOIN r_key_ext b ON a.k_varchar = b.k_varchar AND (a.payload < b.metric OR a.k_dec64 = b.k_dec64) ORDER BY 1, 2;
   payload   |   metric    |
============================
         101 |         201 |
         102 |         202 |

taos> SELECT a.payload, b.metric FROM l_key_ext a JOIN r_key_ext b ON a.k_varchar = b.k_varchar AND (a.payload < b.metric AND a.k_dec64 = b.k_dec64) ORDER BY 1, 2;
   payload   |   metric    |
============================
         101 |         201 |
         102 |         202 |

