
taos> USE join_condition_relaxation_3dn;
Database changed.

taos> SELECT a.id, b.id FROM l_dist a JOIN r_dist b ON a.v < b.v ORDER BY 1, 2;
     id      |     id      |
============================
           1 |          11 |
           1 |          12 |
           1 |          13 |
           2 |          12 |
           2 |          13 |
           3 |          13 |

taos> SELECT a.id, b.id FROM l_dist a LEFT JOIN r_dist b ON a.v < b.v ORDER BY 1, 2;
     id      |     id      |
============================
           1 |          11 |
           1 |          12 |
           1 |          13 |
           2 |          12 |
           2 |          13 |
           3 |          13 |
           4 | NULL        |

taos> SELECT a.id, b.id FROM l_dist a RIGHT JOIN r_dist b ON a.v < b.v ORDER BY 1, 2;
