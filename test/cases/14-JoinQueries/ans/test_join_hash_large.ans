
taos> USE hash_join_snap;
Database changed.

taos> SELECT a.device, a.region, a.seq, a.val, b.seq, b.metric, b.status FROM l_complex a JOIN r_complex b ON a.device = b.device AND a.region = b.region ORDER BY a.val DESC, b.metric ASC, a.seq, b.seq LIMIT 10;
