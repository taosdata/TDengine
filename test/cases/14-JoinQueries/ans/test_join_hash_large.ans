taos> SELECT COUNT(*), COUNT(a.val), COUNT(b.metric) FROM (SELECT ts, k, shard, group_id, val FROM l_scale WHERE group_id = 0) a FULL JOIN (SELECT ts, k, shard, group_id, metric FROM r_scale WHERE group_id = 0) b ON a.k = b.k AND a.shard = b.shard;
