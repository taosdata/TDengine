taos> SELECT COUNT(*) FROM l_complex a JOIN r_complex b ON a.device = b.device AND a.region = b.region AND a.val < b.metric AND b.status = 1;
       count(*)        |
========================
                     7 |

taos> SELECT COUNT(*) FROM l_complex a JOIN r_complex b ON a.device = b.device AND a.region = b.region AND (a.val < b.metric OR b.status = 1);
       count(*)        |
========================
                    13 |

