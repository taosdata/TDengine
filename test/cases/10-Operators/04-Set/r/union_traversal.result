taos> select * from (              select to_char(t.f_ts, 'YYYY-MM-DD HH24:MI') as f_ax_0,                     t.f_if as f_ax_1, round(cast(avg(cast(t.f_err as double)) as double), 8) as f_ay_0              from (select bucket as f_ts, if_name as f_if, `出站错误包数` as f_err                    from (SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '3天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) <= 259200000  partition by host_name,host_group,ip_address,if_name  INTERVAL(1m) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '3-7天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 259200000    AND timediff(1788191940000,1788105600000,1a) <= 604800000  partition by host_name,host_group,ip_address,if_name  INTERVAL(2m) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '7-15天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 604800000    AND timediff(1788191940000,1788105600000,1a) <= 1296000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(5m) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '15-30天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 1296000000    AND timediff(1788191940000,1788105600000,1a) <= 2592000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(10m) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '30-90天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 2592000000    AND timediff(1788191940000,1788105600000,1a) <= 7776000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(30m) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '90天-180天' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 7776000000    AND timediff(1788191940000,1788105600000,1a) <= 15552000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(1h) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '180天-1年' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 15552000000    AND timediff(1788191940000,1788105600000,1a) <= 31536000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(2h) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '1年-3年' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 31536000000    AND timediff(1788191940000,1788105600000,1a) <= 94608000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(5h) FILL(NONE)  UNION ALL  SELECT _wstart AS bucket,         AVG(CAST(traffic_in AS FLOAT)) AS `入站流量`,         AVG(CAST(traffic_out AS FLOAT)) AS `出站流量`,         AVG(CAST(packet_errors_in AS FLOAT)) AS `入站错误包数`,         AVG(CAST(packet_errors_out AS FLOAT)) AS `出站错误包数`,         AVG(CAST(packet_drops_in AS FLOAT)) AS `入站丢包数`,         AVG(CAST(packet_drops_out AS FLOAT)) AS `出站丢包数`,         AVG(CAST(link_status AS FLOAT)) AS `网卡链路状态`,         '3年以上' as type,         host_name,         host_group,         ip_address,         if_name  FROM host_linux_1m_net_metrics  WHERE ip_address = '10.12.180.40'    and ts >= 1788105600000    AND ts < 1788191940000  AND timediff(1788191940000,1788105600000,1a) > 94608000000  partition by host_name,host_group,ip_address,if_name  INTERVAL(1d) FILL(NONE)) u) t              group by to_char(t.f_ts, 'YYYY-MM-DD HH24:MI'), t.f_if          ) result order by f_ax_0, f_ax_1 \G;
