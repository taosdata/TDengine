taos> SELECT v, seq, bucket, aux, marker FROM (SELECT unique(label) AS v, seq, bucket, aux, marker FROM (SELECT seq, bucket, aux, marker, label FROM t_unique ORDER BY seq)) ORDER BY v NULLS FIRST;
