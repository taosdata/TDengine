
taos> use text_nots_db;
Database changed.

taos> DROP TABLE IF EXISTS ref_ts;
Drop OK, 0 row(s) affected 

taos> CREATE TABLE ref_ts (ts TIMESTAMP, id INT, label VARCHAR(32));
Create OK, 0 row(s) affected 

taos> INSERT INTO ref_ts VALUES ('2024-01-01 00:00:00',1,'alpha')('2024-01-02 00:00:00',2,'beta')('2024-01-03 00:00:00',3,'gamma');
Insert OK, 3 row(s) affected 

taos> SELECT id, score FROM TEXT(id INT, score FLOAT) VALUES (2,2.5)(1,1.5)(3,3.5) t ORDER BY id;

DB error: TEXT source requires the first column to be TIMESTAMP [0x80002600] 
taos> SELECT grp, COUNT(id) FROM TEXT(id INT, grp VARCHAR(4)) VALUES (1,'a')(2,'a')(3,'b') t GROUP BY grp ORDER BY grp;

DB error: TEXT source requires the first column to be TIMESTAMP [0x80002600] 
taos> SELECT ts, id FROM TEXT(ts TIMESTAMP, id INT) VALUES ('2024-01-03 00:00:00',3)('2024-01-01 00:00:00',1)('2024-01-02 00:00:00',2) t ORDER BY ts;
           ts            |     id      |
========================================
 2024-01-01 00:00:00.000 |           1 |
 2024-01-02 00:00:00.000 |           2 |
 2024-01-03 00:00:00.000 |           3 |

taos> SELECT t.id, r.label FROM TEXT(ts TIMESTAMP, id INT) VALUES ('2024-01-03 00:00:00',3)('2024-01-01 00:00:00',1)('2024-01-02 00:00:00',2) t JOIN ref_ts r ON t.ts=r.ts ORDER BY t.ts;
     id      |             label              |
===============================================
           1 | alpha                          |
           2 | beta                           |
           3 | gamma                          |

taos> SELECT _wstart, COUNT(*) FROM (SELECT ts, id FROM TEXT(ts TIMESTAMP, id INT) VALUES ('2024-01-05 00:00:00',3)('2024-01-01 00:00:00',1)('2024-01-02 00:00:00',2) t) INTERVAL(3d);
         _wstart         |       count(*)        |
==================================================
 2023-12-31 00:00:00.000 |                     2 |
 2024-01-03 00:00:00.000 |                     1 |

taos> SELECT t.id, r.label FROM TEXT(ts TIMESTAMP, id INT) VALUES ('2024-01-03 00:00:00',3)('2024-01-01 00:00:00',1)('2024-01-04 00:00:00',4) t LEFT JOIN ref_ts r ON t.ts=r.ts ORDER BY t.ts;
     id      |             label              |
===============================================
           1 | alpha                          |
           3 | gamma                          |
           4 | NULL                           |

