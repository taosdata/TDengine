
taos> drop database if exists duplicate_subqueries;
Drop OK, 0 row(s) affected

taos> create database duplicate_subqueries vgroups 2 keep 36500;
Create OK, 0 row(s) affected

taos> use duplicate_subqueries;
Database changed.

taos> create table readings (ts timestamp, v int, d double);
Create OK, 0 row(s) affected

taos> create table history (ts timestamp, v int, s varchar(64));
Create OK, 0 row(s) affected

taos> insert into readings values (1760000000000, 1, 1) (1760000001000, 2, 4) (1760000002000, null, null) (1760000003000, 4, 4);
Insert OK, 4 row(s) affected

taos> insert into history values (1760000000000, 1, 'one') (1760000001000, null, null) (1760000003000, 4, 'four');
Insert OK, 3 row(s) affected

