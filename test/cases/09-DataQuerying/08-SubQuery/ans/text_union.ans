
taos> use text_union_db;
Database changed.

taos> DROP STABLE IF EXISTS meters;
Drop OK, 0 row(s) affected 

taos> CREATE STABLE meters(ts TIMESTAMP, volt INT) TAGS(loc NCHAR(8));
Create OK, 0 row(s) affected 

taos> CREATE TABLE m1 USING meters TAGS('f1');
Create OK, 0 row(s) affected 

taos> INSERT INTO m1 VALUES ('2026-04-01 00:00:00',100)('2026-04-01 00:01:00',200)('2026-04-01 00:02:00',300);
Insert OK, 3 row(s) affected 

taos> SELECT * FROM (SELECT id, name FROM TEXT(id INT, name VARCHAR(8)) VALUES (1,'alpha')(2,'beta') t UNION ALL SELECT id, name FROM TEXT(id INT, name VARCHAR(8)) VALUES (3,'gamma')(4,'delta') t2) sub ORDER BY id;

DB error: TEXT source requires the first column to be TIMESTAMP [0x80002600] 
