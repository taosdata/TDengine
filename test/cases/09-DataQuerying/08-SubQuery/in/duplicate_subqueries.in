# Prepare data.
drop database if exists duplicate_subqueries;
create database duplicate_subqueries vgroups 2 keep 36500;
use duplicate_subqueries;
create table readings (ts timestamp, v int, d double);
create table history (ts timestamp, v int, s varchar(64));
insert into readings values (1760000000000, 1, 1) (1760000001000, 2, 4) (1760000002000, null, null) (1760000003000, 4, 4);
insert into history values (1760000000000, 1, 'one') (1760000001000, null, null) (1760000003000, 4, 'four');

