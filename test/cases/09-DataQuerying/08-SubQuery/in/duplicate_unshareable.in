# Prepare data.
drop database if exists duplicate_unshareable;
create database duplicate_unshareable vgroups 2 keep 36500;
use duplicate_unshareable;
create table matrix_readings (ts timestamp, k int, v int, d double);
create table matrix_history (ts timestamp, k int, v int);
create table matrix_other (ts timestamp, k int, v int);
insert into matrix_readings values (1760000000000, 1, 10, 10);
insert into matrix_readings values (1760000001000, 2, 20, 20);
insert into matrix_readings values (1760000002000, 3, 30, 30);
insert into matrix_readings values (1760000003000, 2, null, null);
insert into matrix_readings values (1760000004000, null, 40, 40);
insert into matrix_history values (1760000000000, 1, 5);
insert into matrix_history values (1760000001000, 1, 15);
insert into matrix_history values (1760000002000, 2, 20);
insert into matrix_history values (1760000003000, 3, null);
insert into matrix_other values (1760000000000, 1, 100);

