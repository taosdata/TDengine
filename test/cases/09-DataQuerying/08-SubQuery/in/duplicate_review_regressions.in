select count(distinct vgroup_id) from information_schema.ins_tables where db_name = 'duplicate_review_regressions' and table_name like 'distributed_r_%';
select count(distinct vgroup_id) from information_schema.ins_tables where db_name = 'duplicate_review_regressions' and table_name like 'distributed_h_%';
select v, (select max(v) from distributed_history) from distributed_readings where v <= (select max(v) from distributed_history) order by ts;
# Expected InitPlans 1, correlated templates 0.
explain verbose true select v, (select max(v) from distributed_history) from distributed_readings where v <= (select max(v) from distributed_history) order by ts\G;
explain analyze verbose true select v, (select max(v) from distributed_history) from distributed_readings where v <= (select max(v) from distributed_history) order by ts\G;
select v, v in (select v from distributed_history) from distributed_readings where v in (select v from distributed_history) order by ts;
