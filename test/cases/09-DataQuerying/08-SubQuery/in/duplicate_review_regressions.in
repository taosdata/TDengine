# Prepare data.
drop database if exists duplicate_review_regressions;
create database duplicate_review_regressions vgroups 2 keep 36500;
use duplicate_review_regressions;
create table matrix_readings (ts timestamp, k int, v int, d double);
create table matrix_history (ts timestamp, k int, v int);
create table matrix_other (ts timestamp, k int, v int);
insert into matrix_readings values (1760000000000, 1, 10, 10);
insert into matrix_readings values (1760000001000, 2, 20, 20);
insert into matrix_readings values (1760000002000, 3, 30, 30);
insert into matrix_readings values (1760000003000, 2, null, null);
insert into matrix_readings values (1760000004000, null, 40, 40);
insert into matrix_history values (1760000000000, 1, 5);
insert into matrix_history values (1760000001000, 1, 15);
insert into matrix_history values (1760000002000, 2, 20);
insert into matrix_history values (1760000003000, 3, null);
insert into matrix_other values (1760000000000, 1, 100);

# Union operand regressions.
select (select max(s.v) from (select v from matrix_history union all select v from matrix_history) s), (select max(d.v) from (select v from matrix_history union all select v from matrix_other) d) from matrix_readings limit 1;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select (select max(s.v) from (select v from matrix_history union all select v from matrix_history) s), (select max(d.v) from (select v from matrix_history union all select v from matrix_other) d) from matrix_readings limit 1\G;
explain analyze verbose true select (select max(s.v) from (select v from matrix_history union all select v from matrix_history) s), (select max(d.v) from (select v from matrix_history union all select v from matrix_other) d) from matrix_readings limit 1\G;
select 100 in (select v from matrix_history union select v from matrix_history), 100 in (select v from matrix_history union select v from matrix_other) from matrix_readings limit 1;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select 100 in (select v from matrix_history union select v from matrix_history), 100 in (select v from matrix_history union select v from matrix_other) from matrix_readings limit 1\G;
explain analyze verbose true select 100 in (select v from matrix_history union select v from matrix_history), 100 in (select v from matrix_history union select v from matrix_other) from matrix_readings limit 1\G;
select r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 20) from matrix_readings r order by r.ts;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 20) from matrix_readings r order by r.ts\G;
explain analyze verbose true select r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union select v from matrix_history where v > 20) from matrix_readings r order by r.ts\G;
select 100 in (select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other) from matrix_readings limit 1;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select 100 in (select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other) from matrix_readings limit 1\G;
explain analyze verbose true select 100 in (select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other) from matrix_readings limit 1\G;
select r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 20) from matrix_readings r order by r.ts;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 20) from matrix_readings r order by r.ts\G;
explain analyze verbose true select r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 15), r.v in (select v from matrix_history where k = 1 union all select v from matrix_history where v > 20) from matrix_readings r order by r.ts\G;
select 100 in (select v from matrix_history union all select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all select v from matrix_history) from matrix_readings limit 1;
# Expected InitPlans 2, correlated templates 0.
explain verbose true select 100 in (select v from matrix_history union all select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all select v from matrix_history) from matrix_readings limit 1\G;
explain analyze verbose true select 100 in (select v from matrix_history union all select v from matrix_history union all select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all select v from matrix_history) from matrix_readings limit 1\G;
select 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history) from matrix_readings limit 1;
# Expected InitPlans 1, correlated templates 0.
explain verbose true select 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history) from matrix_readings limit 1\G;
explain analyze verbose true select 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history), 100 in (select v from matrix_history union all select v from matrix_other union all  select v from matrix_history) from matrix_readings limit 1\G;

# Nested external window regressions.
select * from (select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w)) x;
# Expected InitPlans 3, correlated templates 0.
explain verbose true select * from (select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w)) x\G;
explain analyze verbose true select * from (select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w)) x\G;
# Sort output rows for deterministic comparison.
select count(*), max(v), max(v) from matrix_readings union all select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w) order by 1 nulls first, 2 nulls first, 3 nulls first;
# Expected InitPlans 3, correlated templates 0.
explain verbose true select count(*), max(v), max(v) from matrix_readings union all select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w)\G;
explain analyze verbose true select count(*), max(v), max(v) from matrix_readings union all select count(*) as n, (select max(v) from matrix_history) as a, (select max(v) from matrix_history) as b from matrix_readings external_window((select ts, ts + 999 as endtime from matrix_history) w)\G;

# Distributed consumers.
# Parallel ANALYZE counters appear as <runtime> in the answer file.
create stable distributed_readings (ts timestamp, v int) tags (device int);
create stable distributed_history (ts timestamp, v int) tags (device int);
create table distributed_r_0 using distributed_readings tags (0);
create table distributed_h_0 using distributed_history tags (0);
insert into distributed_r_0 values (1760000000000, 0);
insert into distributed_h_0 values (1760000000000, 0);
