use correlated_scalar_positions;
select r.v, t.lim from readings r left join thresholds t on r.ts = t.ts and r.device = t.device and r.v < (select max(x.lim) from thresholds x where x.device = r.device) order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select max(t.lim) from thresholds t where t.device = r.device ) > 0 order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select max(t.lim) from thresholds t where t.lim < r.v ) > 0 order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select max(t.lim) from thresholds t where t.ts <= r.ts ) > 0 order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select max(t.lim) from thresholds t where t.device = r.device and t.lim < r.v ) > 0 order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select count(*) from thresholds t where t.device = r.device ) > 0 order by r.ts;
select r.v, j.lim from readings r left join thresholds j on r.ts = j.ts and r.device = j.device and (select count(*) from thresholds t where t.lim < r.v ) > 0 order by r.ts;
