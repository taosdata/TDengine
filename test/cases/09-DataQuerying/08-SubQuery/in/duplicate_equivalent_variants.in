select (select max(s.x) from (select cast(v as int) as x, cast(v + 100 as int) as y from matrix_history) s), (select max(d.x) from (select cast(v as int) as y, cast(v + 100 as int) as x from matrix_history) d) from matrix_readings limit 1;
