select sum(coalesce((select (select max(t.lim) from thresholds t where t.ts <= r.ts ) from thresholds m limit 1), 0)) as total from readings r;
select sum(coalesce((select (select max(t.lim) from thresholds t where t.device = r.device and t.lim < r.v ) from thresholds m limit 1), 0)) as total from readings r;
select sum(coalesce((select (select count(*) from thresholds t where t.device = r.device ) from thresholds m limit 1), 0)) as total from readings r;
select sum(coalesce((select (select count(*) from thresholds t where t.lim < r.v ) from thresholds m limit 1), 0)) as total from readings r;
select sum(coalesce((select (select count(*) from thresholds t where t.ts <= r.ts ) from thresholds m limit 1), 0)) as total from readings r;
