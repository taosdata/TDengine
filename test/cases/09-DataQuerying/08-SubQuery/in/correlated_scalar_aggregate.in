use correlated_scalar_positions;
select sum(coalesce((select max(t.lim) from thresholds t where t.device = r.device), 0)) as sum_lim from readings r;
select sum(coalesce((select max(t.lim) from thresholds t where t.device = r.device ), 0)) as total from readings r;
select sum(coalesce((select max(t.lim) from thresholds t where t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select max(t.lim) from thresholds t where t.ts <= r.ts ), 0)) as total from readings r;
select sum(coalesce((select max(t.lim) from thresholds t where t.device = r.device and t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select count(*) from thresholds t where t.device = r.device ), 0)) as total from readings r;
select sum(coalesce((select count(*) from thresholds t where t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select count(*) from thresholds t where t.ts <= r.ts ), 0)) as total from readings r;
select sum(coalesce((select count(*) from thresholds t where t.device = r.device and t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select min(t.lim) from thresholds t where t.device = r.device ), 0)) as total from readings r;
select sum(coalesce((select min(t.lim) from thresholds t where t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select min(t.lim) from thresholds t where t.ts <= r.ts ), 0)) as total from readings r;
select sum(coalesce((select min(t.lim) from thresholds t where t.device = r.device and t.lim < r.v ), 0)) as total from readings r;
