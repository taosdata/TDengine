select sum(coalesce((select sum(t.lim) from thresholds t where t.ts <= r.ts ), 0)) as total from readings r;
select sum(coalesce((select sum(t.lim) from thresholds t where t.device = r.device and t.lim < r.v ), 0)) as total from readings r;
select sum(coalesce((select t.lim from thresholds t where t.device = r.device order by t.ts desc limit 1), 0)) as total from readings r;
select sum(coalesce((select t.lim from thresholds t where t.lim < r.v order by t.ts desc limit 1), 0)) as total from readings r;
select sum(coalesce((select t.lim from thresholds t where t.ts <= r.ts order by t.ts desc limit 1), 0)) as total from readings r;
select sum(coalesce((select t.lim from thresholds t where t.device = r.device and t.lim < r.v order by t.ts desc limit 1), 0)) as total from readings r;
select sum(coalesce((select (select max(t.lim) from thresholds t where t.device = r.device ) from thresholds m limit 1), 0)) as total from readings r;
