select sum(coalesce((select (select (select t.lim from thresholds t where t.device = r.device and t.lim < r.v order by t.ts desc limit 1) from thresholds m limit 1) from thresholds n limit 1), 0)) as total from readings r;
select r.v, (select max((select max(x.v) from readings x where x.device = t.device)) from thresholds t where t.device = r.device) as result from readings r order by r.ts;
