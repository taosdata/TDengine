use correlated_scalar_positions;
select r.v, case when r.v > (select max(t.lim) from thresholds t where t.device = r.device) then 1 else 0 end as above_lim from readings r order by r.ts;
select r.v, case when (select max(t.lim) from thresholds t where t.device = r.device ) is null then 0 else 1 end as has_result from readings r order by r.ts;
