
taos> alter local "timezone" "UTC";

taos> select a from vfilter_query.filter_normal where a = 10;

taos> select a from vfilter_query.filter_normal where a != 11;

taos> select bounded from vfilter_query.filter_normal where bounded < 11;

taos> select c from vfilter_query.filter_normal where ts < '2024-01-01 00:00:01';

taos> select count(*) as rows_n, count(bounded) as bounded_n, sum(bounded) as bounded_sum from vfilter_query.filter_normal where bounded < 11;
 rows_n | bounded_n | bounded_sum |
================
 0 | 0 | NULL |

taos> select cast(ts as bigint) as ts_ms, a, bounded, c from vfilter_query.filter_normal where a <= 11 and bounded <= 11 and ts <= '2024-01-01 00:00:01' order by ts;
 ts_ms | a | bounded | c |
================
 1704067201000 | 11 | 11 | 11 |

taos> select bounded from vfilter_query.filter_normal where bounded < 11 or bounded = 13 order by ts;
 bounded |
================
 13 |

taos> select cast(ts as bigint) as ts_ms, b, c from vfilter_query.filter_normal where ts < '2024-01-01 00:00:01' order by ts, b;
 ts_ms | b | c |
================
 1704067200000 | 100 | NULL |

