alter local "timezone" "UTC";
select a from vfilter_query.filter_normal where a = 10;
select a from vfilter_query.filter_normal where a != 11;
select bounded from vfilter_query.filter_normal where bounded < 11;
select c from vfilter_query.filter_normal where ts < '2024-01-01 00:00:01';
select count(*) as rows_n, count(bounded) as bounded_n, sum(bounded) as bounded_sum from vfilter_query.filter_normal where bounded < 11;
select cast(ts as bigint) as ts_ms, a, bounded, c from vfilter_query.filter_normal where a <= 11 and bounded <= 11 and ts <= '2024-01-01 00:00:01' order by ts;
select bounded from vfilter_query.filter_normal where bounded < 11 or bounded = 13 order by ts;
select cast(ts as bigint) as ts_ms, b, c from vfilter_query.filter_normal where ts < '2024-01-01 00:00:01' order by ts, b;
