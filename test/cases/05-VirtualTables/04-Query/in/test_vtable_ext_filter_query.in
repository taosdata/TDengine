alter local "timezone" "UTC";
select cast(ts as bigint) as ts_ms, a, c from vfilter_query.filter_normal where a < 12 or c >= 23 order by ts;
select a, c from vfilter_query.filter_normal where a >= 20;
select cast(ts as bigint) as ts_ms, a, c from vfilter_query.filter_normal where a >= 11 and c >= 23 order by ts;
select cast(ts as bigint) as ts_ms, a, c from vfilter_query.chain where ts >= 1704067201000 and ts < 1704067206000 order by ts desc limit 2 offset 1;
select ts_ms, a, c from (select cast(ts as bigint) as ts_ms, a, c from vfilter_query.chain) where a <= 11 or c = 26 order by ts_ms;
select a as v from vfilter_query.filter_normal where a < 12 union all select c as v from vfilter_query.chain where c >= 23 order by v;
select cast(l.ts as bigint) as ts_ms, l.a, r.c from vfilter_query.filter_normal l join vfilter_query.chain r on l.ts = r.ts order by l.ts;
select cast(l.ts as bigint) as ts_ms, l.a, r.c from vfilter_query.filter_normal l left join vfilter_query.chain r on l.ts = r.ts where l.a >= 11 order by l.ts;
select scenario, cast(ts as bigint) as ts_ms, a, c from vfilter_query.filter_stable where scenario = 1 and a >= 11 and ts <= 1704067203000 order by ts;
select a, c from vfilter_query.chain_stable where a > 100 or c > 100;
