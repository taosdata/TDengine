set max_binary_display_width 280;

# not optimized: one external source would be scanned twice
explain verbose true select _wstart, _wend, sum(source_v) from vt_window_federated_batch.vst_single_source session(ts, 1500a) order by _wstart;

# not optimized: one sourceName is still one external execution unit
explain verbose true select _wstart, _wend, sum(primary_v), sum(aux_v) from vt_window_federated_batch.vst_same_source session(ts, 1500a) order by _wstart;

# optimized: partial aggregates are calculated per source and merged after window alignment
explain verbose true select _wstart, _wend, sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v) from vt_window_federated_batch.vst_mixed_sources session(ts, 1500a) order by _wstart;

# optimized: local and external partial aggregates share the same merge path
explain verbose true select _wstart, _wend, sum(local_v), sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v) from vt_window_federated_batch.vst_local_external session(ts, 1500a) order by _wstart;

# optimized: AVG is calculated as partial state instead of combining finalized scalars
explain verbose true select _wstart, _wend, avg(mysql_a_v), avg(mysql_b_v), avg(postgres_v) from vt_window_federated_batch.vst_mixed_sources session(ts, 1500a) order by _wstart;

# not optimized: session windows do not split a virtual-scan row filter
explain verbose true select _wstart, _wend, sum(mysql_a_v) from vt_window_federated_batch.vst_mixed_sources where mysql_a_v + postgres_v > 0 session(ts, 1500a) order by _wstart;

# not optimized: count(*) has no owning execution unit
explain verbose true select _wstart, _wend, count(*) from vt_window_federated_batch.vst_mixed_sources session(ts, 1500a) order by _wstart;

# not optimized: one aggregate expression must not span execution units
explain verbose true select _wstart, _wend, sum(mysql_a_v + postgres_v) from vt_window_federated_batch.vst_mixed_sources session(ts, 1500a) order by _wstart;

# not optimized: aggregate functions must not reference tags
explain verbose true select _wstart, _wend, sum(scenario) from vt_window_federated_batch.vst_single_source session(ts, 1500a) order by _wstart;

# optimized: SQL Server joins the per-source partial aggregate merge
explain verbose true select _wstart, _wend, sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v), sum(sqlserver_v) from vt_window_federated_batch.vst_ss_sources session(ts, 1500a) order by _wstart;

# optimized: SQL Server source mixed with the internal table
explain verbose true select _wstart, _wend, sum(local_v), sum(sqlserver_v) from vt_window_federated_batch.vst_local_ss session(ts, 1500a) order by _wstart;

# Oracle source mixed across two tables of one source
explain verbose true select _wstart, _wend, sum(primary_v), sum(aux_v) from vt_window_federated_batch.vst_oracle_sources session(ts, 1500a) order by _wstart;

# optimized: Oracle source mixed with the internal table
explain verbose true select _wstart, _wend, sum(local_v), sum(oracle_v) from vt_window_federated_batch.vst_local_oracle session(ts, 1500a) order by _wstart;
