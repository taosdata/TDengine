explain verbose true select sum(local_v),sum(remote_v) from vt_pushdown_agg.vt_influx18 where local_v>1;
explain analyze verbose true select sum(local_v),sum(remote_v) from vt_pushdown_agg.vt_influx18 where local_v>1;

select sum(remote_v) from vt_pushdown_agg.vt_influx18 where local_v>1;
