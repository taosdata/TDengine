set max_binary_display_width 280;

# optimized: one external table under one sourceName
explain verbose true select _wstart, _wend, sum(source_v) from vt_window_federated_batch.vst_single_source interval(2s) order by _wstart;

# optimized: multiple external tables under the same sourceName
explain verbose true select _wstart, _wend, sum(primary_v), sum(aux_v) from vt_window_federated_batch.vst_same_source interval(2s) order by _wstart;

# optimized: references mixed across multiple external sourceNames
explain verbose true select _wstart, _wend, sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v) from vt_window_federated_batch.vst_mixed_sources interval(2s) order by _wstart;

# optimized: references mixed across local and external sources
explain verbose true select _wstart, _wend, sum(local_v), sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v) from vt_window_federated_batch.vst_local_external interval(2s) order by _wstart;

# not optimized: a row filter must not span execution units
explain verbose true select _wstart, _wend, sum(mysql_a_v) from vt_window_federated_batch.vst_mixed_sources where mysql_a_v + postgres_v > 0 interval(2s) order by _wstart;

# not optimized: count(*) has no owning execution unit
explain verbose true select _wstart, _wend, count(*) from vt_window_federated_batch.vst_mixed_sources interval(2s) order by _wstart;

# not optimized: distinct aggregates cannot use split interval execution
#explain verbose true select _wstart, _wend, count(distinct mysql_a_v) from vt_window_federated_batch.vst_mixed_sources interval(2s) order by _wstart;

# not optimized: one aggregate expression must not span execution units
explain verbose true select _wstart, _wend, sum(mysql_a_v + postgres_v) from vt_window_federated_batch.vst_mixed_sources interval(2s) order by _wstart;

# optimized: SQL Server joins the split interval execution
explain verbose true select _wstart, _wend, sum(mysql_a_v), sum(mysql_b_v), sum(postgres_v), sum(sqlserver_v) from vt_window_federated_batch.vst_ss_sources interval(2s) order by _wstart;

# optimized: SQL Server source mixed with the internal table
explain verbose true select _wstart, _wend, sum(local_v), sum(sqlserver_v) from vt_window_federated_batch.vst_local_ss interval(2s) order by _wstart;
