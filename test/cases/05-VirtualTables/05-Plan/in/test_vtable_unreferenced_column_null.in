use test_vtable_select;
select 8 as idx, last(int_col) as val, _c0 as ts, tinyint_col as q from vtb_null_ntb;
select 8 as idx, last(int_col) as val, _c0 as ts, tinyint_col as q from vtb_null_ctb;
select last(int_col), _c0, bool_col as q, u_bigint_col as counter, binary_16_col as quality, nchar_16_col as label from vtb_null_ntb;
select last(int_col), _c0, bool_col as q, u_bigint_col as counter, binary_16_col as quality, nchar_16_col as label from vtb_null_ctb;
select last(int_col), _c0, coalesce(tinyint_col, 7) as q, tinyint_col + 1 as next_q from vtb_null_ntb;
select last(int_col), _c0, coalesce(tinyint_col, 7) as q, tinyint_col + 1 as next_q from vtb_null_ctb;
select last(int_col), _c0, tinyint_col as q from vtb_null_ntb where tinyint_col is null;
select last(int_col), _c0, tinyint_col as q from vtb_null_ctb where tinyint_col is null;
select last(int_col), _c0, tinyint_col as q from vtb_null_ntb where tinyint_col is not null;
select last(int_col), _c0, tinyint_col as q from vtb_null_ctb where tinyint_col is not null;
select last(int_col), _c0, tinyint_col as q from vtb_null_ntb where ts = '2025-06-17 04:00:00.000';
select last(int_col), _c0, tinyint_col as q from vtb_null_ctb where ts = '2025-06-17 04:00:00.000';
select last(int_col), _c0, tinyint_col as q from vtb_null_ntb where ts > '2025-06-17 04:00:00.000';
select last(int_col), _c0, tinyint_col as q from vtb_null_ctb where ts > '2025-06-17 04:00:00.000';
select tinyint_col, count(int_col) from vtb_null_ntb group by tinyint_col;
select tinyint_col, count(int_col) from vtb_null_ctb group by tinyint_col;
select last(int_col), count(tinyint_col), sum(tinyint_col) from vtb_null_ntb;
select last(int_col), count(tinyint_col), sum(tinyint_col) from vtb_null_ctb;
select count(tinyint_col), sum(tinyint_col), last(tinyint_col) from vtb_null_ntb;
select count(tinyint_col), sum(tinyint_col), last(tinyint_col) from vtb_null_ctb;
select tinyint_col from vtb_null_ntb;
select tinyint_col from vtb_null_ctb;
select count(int_col) from vtb_null_ntb session(aux_ts, 1s);
select count(int_col) from vtb_null_ctb session(aux_ts, 1s);
select ts, int_col, float_col, tinyint_col as q from vtb_null_ntb order by ts desc limit 2;
select ts, int_col, float_col, tinyint_col as q from vtb_null_ctb order by ts desc limit 2;
select ts, int_col, tinyint_col as q from vtb_null_ntb order by ts desc limit 2;
select ts, int_col, tinyint_col as q from vtb_null_ctb order by ts desc limit 2;
select last(v), _c0, q from (select ts, int_col as v, tinyint_col as q from vtb_null_ntb);
select last(v), _c0, q from (select ts, int_col as v, tinyint_col as q from vtb_null_ctb);
select last(int_col), _c0, tinyint_col as q, int_tag from vtb_null_ctb;
select last(int_col), _c0, tinyint_col as q from vtb_virtual_ntb_empty;
select last(int_col), _c0, tinyint_col as q from vtb_virtual_ctb_empty_0;
select last(tinyint_col) from vtb_virtual_stb;
select tinyint_col, last(int_col) from vtb_null_ntb where ts >= '2020-10-01 00:00:01.998' and ts < '2020-10-01 00:00:04.000' interval(1s) fill(value, 7, 9);
select tinyint_col, last(int_col) from vtb_null_ctb where ts >= '2020-10-01 00:00:01.998' and ts < '2020-10-01 00:00:04.000' interval(1s) fill(value, 7, 9);
select int_col_a, tinyint_col_a from table(time_align(table vtb_null_ntb, false, '*:PREV:_a')) order by ts limit 2;
select int_col_a, tinyint_col_a from table(time_align(table vtb_null_ctb, false, '*:PREV:_a')) order by ts limit 2;
select count(*) as n from (select v.int_col as lval, r.int_col as rval from vtb_null_ntb v left window join vtb_org_tb_0 r window_time(v.aux_ts, r.ts) window_offset(-1s, 1s));
select count(*) as n from (select v.int_col as lval, r.int_col as rval from vtb_null_ctb v left window join vtb_org_tb_0 r window_time(v.aux_ts, r.ts) window_offset(-1s, 1s));
select v.int_col, (select count(*) from vtb_org_tb_0 r where r.int_col < v.tinyint_col) as n from vtb_null_ntb v where v.ts = '2020-10-01 00:00:01.998';
select v.int_col, (select count(*) from vtb_org_tb_0 r where r.int_col < v.tinyint_col) as n from vtb_null_ctb v where v.ts = '2020-10-01 00:00:01.998';
select tinyint_col, last(int_col) from vtb_null_ntb external_window((select ts + 1s, ts + 1004a from vtb_org_tb_0 where ts in ('2020-10-01 00:00:00.000', '2020-10-01 00:00:01.998')) w) fill(value, 7, 9) order by _wstart;
select tinyint_col, last(int_col) from vtb_null_ctb external_window((select ts + 1s, ts + 1004a from vtb_org_tb_0 where ts in ('2020-10-01 00:00:00.000', '2020-10-01 00:00:01.998')) w) fill(value, 7, 9) order by _wstart;
select sum(int_col) over (partition by tinyint_col) as s from vtb_null_ntb where ts <= '2020-10-01 00:00:00.002';
select sum(int_col) over w as s from vtb_null_ctb where ts <= '2020-10-01 00:00:00.002' window w as (partition by tinyint_col);
