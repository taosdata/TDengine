              "help": {
                "text": "Vulnerability CVE-2025-61730\nSeverity: medium\nPackage: stdlib\nVersion: go1.14.4\nFix Version: 1.24.12,1.25.6\nType: go-module\nLocation: /source/taos-internal/tests/pytest/go/httpTest_insert\nData Namespace: nvd:cpe\nLink: [CVE-2025-61730](https://nvd.nist.gov/vuln/detail/CVE-2025-61730)",
