<customUI xmlns='http://schemas.microsoft.com/office/2009/07/customui' loadImage='LoadImage'  onLoad='ribbonLoaded'>
  <!-- 在 [XML]中被定义为 空白(whitespace)字符：空格 (&#x0020;) Tab (&#x0009;) 回车 (&#x000D;) 换行 (&#x000A;)-->
  <ribbon startFromScratch="false">
    <tabs>
      <tab id='CustomTab' label='TDengine' insertAfterMso="TabHome">
        <group id='metaGroup' label='meta'>
          <button id='stablesButton' getImage='Button_getImage' label='Query STables' size='large' onAction='StablesButton_Click' screentip="Query STables" supertip="query all stables"/>
          <button id='tablesButton' getImage='Button_getImage' label='Query Tables' size='large' onAction='TablesButton_Click' screentip="Query Tables" supertip="query tables of one stable"/>
        </group>
        <group id='dataGroup' label='data'>
          <button id='aggButton' getImage='Button_getImage' label='Aggregation' size='large' onAction='AggButton_Click' screentip="Aggregation" supertip="aggregation of tables or stables"/>
          <button id='detailButton' getImage='Button_getImage' label='Detail Data Query' size='large' onAction='DetailButton_Click' screentip="Detail Data Query" supertip="query datail data of table"/>
          <button id='sliceButton' getImage='Button_getImage' label='Slice Data Query' size='large' onAction='SliceButton_Click' screentip="Slice Data Query" supertip="query slice data of tables or stables"/>
        </group>
        <group id='formulaGroup' label='formula'>
          <button id='faggButton' getImage='Button_getImage' label='Formula Of Aggregation' size='large' onAction='FAggButton_Click' screentip="Formula of Aggregation" supertip="create or edit formula of aggregation"/>
          <button id='fsliceButton' getImage='Button_getImage' label='Formula Of Slice Data' size='large' onAction='FSliceButton_Click' screentip="Formula of Slice Data" supertip="create or edit formula of slice data"/>
          <button id='fcalcButton' getImage='Button_getImage' label='Calcuate Formulas' size='large' onAction='FCalcButton_Click' screentip="Calculate all the Formulas" supertip="list all the formulas, calculate them and apply the results to each cells"/>
        </group>
        <group id='othersGroup' label='others'>
          <button id='connectButton' getImage='Button_getImage' label='Connect TDengine' size='large' onAction='ConnectButton_Click' screentip="Connect TDengine" supertip="set connetion parameters of TDengine"/>
          <button id='aboutButton' getImage='Button_getImage' label='Contact US' size='large' onAction='AboutButton_Click' screentip="Contact US" supertip="about this plugin"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>