{
  "filetype": "subscribe",
  "cfgdir": "/etc/taos",
  "host": "127.0.0.1",
  "port": 6030,
  "user": "root",
  "password": "taosdata",
  "databases": "test",
  "specified_table_query": {
    "concurrent": 1,
    "mode": "sync",
    "interval": 1000,
    "restart": "yes",
    "keepProgress": "yes",
    "resubAfterConsume": 10,
    "sqls": [
      {
        "sql": "select avg(col1) from meters where col1 > 1;",
        "result_mode": "writefile", 
        "result_file": "./subscribe_res0.txt"
      }
    ]
  }
}
