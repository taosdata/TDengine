print =============== there are nll data 
sql create table mrate1 (ts timestamp, tbcol int) TAGS(tgcol binary(8))

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
sql create table t11 using mrate1 tags('null')
sql create table t12 using mrate1 tags('null')

# val: 10, 11,......, 19
$val = 10
$time = 1
$num = 0
while $num < 10
  $ms = $time . s
  if $num != 6 then
    sql insert into t11 values ($startTime + $ms , $val )
    sql insert into t12 values ($startTime + $ms , $val )
  endi
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 15, 16,......, 24
$val = 15
$num = 0
while $num < 10
  $ms = $time . s
  if $num != 6 then
    sql insert into t11 values ($startTime + $ms , $val )
    sql insert into t12 values ($startTime + $ms , $val )
  endi
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 20, 21,......, 29
