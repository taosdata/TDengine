system sh/stop_dnodes.sh
system sh/ip.sh -i 1 -s up
system sh/deploy.sh -n dnode1 -m 192.168.0.1 -i 192.168.0.1
system sh/cfg.sh -n dnode1 -c commitLog -v 0
system sh/exec.sh -n dnode1 -s start
sleep 3000
sql connect

$dbPrefix = db
$tbPrefix = tb
$mtPrefix = mt
$tbNum = 6
$rowNum = 20
$totalNum = 200

print =============== step1: create db, supertable, subtable, and insert data
$i = 0
$db = db
$mt = $mtPrefix . $i

sql drop database $db -x step1
step1:
sql create database $db
sql use $db
sql create table $mt (ts timestamp, tbcol int) TAGS(tag1 int, tag2 int, tag3 int)

sql create table tb1 using $mt tags( 1, 20, 30 )
sql create table tb2 using $mt tags( 2, 20, 31 )
sql create table tb3 using $mt tags( 3, 21, 30 )
sql create table tb4 using $mt tags( 4, 21, 31 )
sql create table tb5 using $mt tags( 5, 22, 30 )
sql create table tb6 using $mt tags( 6, 22, 31 )

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
$i = 1
$tbNum = $tbNum + 1
while $i < $tbNum
  $tb = $tbPrefix . $i
 
  $x = 0
  $y = 0
  while $x < $rowNum
    $ms = $x . s
    sql insert into $tb values ($startTime + $ms , $y ) 
    $x = $x + 1
    $y = $y + 2
  endw 
 
  $i = $i + 1
endw 

sleep 500

