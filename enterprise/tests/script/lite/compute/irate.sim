print =============== step7     decline case
sql create table mrate (ts timestamp, tbcol int) TAGS(tgcol binary(8))

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
sql create table t1 using mrate tags('decline')

# val: 10, 11,......, 19
$val = 10
$time = 1
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 15, 16,......, 24
$val = 15
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 20, 21,......, 29
$val = 20
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

print =============== step7-1
sql select irate(tbcol) from t1;
print ===> $data00  $data01
print ===> $data10  $data11
print ===> $data20  $data21
print ===> $data30  $data31
print ===> $data40  $data41
print ===> $data50  $date51
if $data00 != 1.000000000 then 
  return -1
endi
 
