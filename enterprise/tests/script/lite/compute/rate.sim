system sh/stop_dnodes.sh
system sh/ip.sh -i 1 -s up
system sh/deploy.sh -n dnode1 -m 192.168.0.1 -i 192.168.0.1
system sh/cfg.sh -n dnode1 -c commitLog -v 0
system sh/exec.sh -n dnode1 -s start
sleep 3000
sql connect

$dbPrefix = m_rt_db
$tbPrefix = m_rt_tb
$mtPrefix = m_rt_mt
$tbNum = 10
$rowNum = 20
$totalNum = 200

print =============== step1
$i = 0
$db = $dbPrefix . $i
$mt = $mtPrefix . $i

sql drop database $db -x step1
step1:
sql create database $db
sql use $db
sql create table $mt (ts timestamp, tbcol int) TAGS(tgcol int)

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
$i = 0
while $i < $tbNum
  $tb = $tbPrefix . $i
  sql create table $tb using $mt tags( $i )
  
  $x = 0
  $y = 0
  while $x < $rowNum
    $ms = $x . s
    sql insert into $tb values ($startTime + $ms , $y ) 
    $x = $x + 1
    $y = $y + 2
  endw 
 
  $i = $i + 1
endw 

sleep 100

print =============== step2
$i = 1
$tb = $tbPrefix . $i

sql select rate(tbcol) from $tb
print ===> $data00  $data10  $data20  $data30  $data40  $data50
if $data00 != 2.000000000 then 
  return -1
endi

