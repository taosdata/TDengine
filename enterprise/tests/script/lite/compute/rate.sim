print =============== step7     decline case
sql create table mrate (ts timestamp, tbcol int) TAGS(tgcol binary(8))

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
sql create table t1 using mrate tags('decline')

# val: 10, 11,......, 19
$val = 10
$time = 1
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 15, 16,......, 24
$val = 15
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 20, 21,......, 29
$val = 20
$num = 0
while $num < 10
  $ms = $time . s
  sql insert into t1 values ($startTime + $ms , $val )
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

sql select rate(tbcol) from t1;
if $data00 != 2.137931034 then 
  return -1
endi
sql select rate(tbcol) from mrate where tgcol='decline' interval(5s)
if $data01 != 1.000000000 then 
  return -1
endi
if $data21 != 4.500000000 then 
  return -1
endi
if $data41 != 5.750000000 then 
  return -1
endi
if $data61 != 0.000000000 then 
  return -1
endi
sql select rate(tbcol) from mrate where tgcol='decline' and ts > '2020-02-02 08:00:06.000' and ts < '2020-02-02 08:00:24.000'  interval(5s)
if $data01 != 1.000000000 then 
  return -1
endi
if $data11 != 4.500000000 then 
  return -1
endi
if $data21 != 1.000000000 then 
  return -1
endi
if $data31 != 7.333333333 then 
  return -1
endi

print =============== step8     there are nll data 
sql create table mrate1 (ts timestamp, tbcol int) TAGS(tgcol binary(8))

# 2020-02-02 08:00:00.000
$startTime = 1580601600000
sql create table t11 using mrate1 tags('null')

# val: 10, 11,......, 19
$val = 10
$time = 1
$num = 0
while $num < 10
  $ms = $time . s
  if $num != 6 then
    sql insert into t11 values ($startTime + $ms , $val )
  endi
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 15, 16,......, 24
$val = 15
$num = 0
while $num < 10
  $ms = $time . s
  if $num != 6 then
    sql insert into t11 values ($startTime + $ms , $val )
  endi
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

# val: 20, 21,......, 29
$val = 20
$num = 0
while $num < 10
  $ms = $time . s
  if $num != 6 then
    sql insert into t11 values ($startTime + $ms , $val )
  endi
  $time = $time + 1
  $num = $num + 1
  $val = $val + 1
endw 

sql select rate(tbcol) from t11;
if $data00 != 2.137931034 then 
  return -1
endi
