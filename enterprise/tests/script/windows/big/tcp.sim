	print ===> $data00 $data01
	if $rows != 1 then
	  return -1
	endi
	if $data00 != 22 then
	  return -1
	endi

	print =============== step4 $i
	sql select * from $mt
	print ===> $data00 $data01
	if $rows != 22 then
	  return -1
	endi

	$i = $i + 1
endw

print =============== step3
$i = 0
while $i < $tbNum
  $tb = $tbPrefix . $i
