sql create database db
sql use db

$dbPrefix = db
$tbPrefix = tb
$mtPrefix = mt
$tbNum = 22000
$rowNum = 10

print =============== step1
$i = 0
$db = $dbPrefix
$mt = $mtPrefix

sql create database $db
sql use $db
sql create table $mt (ts timestamp, tbcol int, tbcol2 float) TAGS(tgcol int)

$i = 0
while $i < $tbNum
  $tb = $tbPrefix . $i
  sql create table $tb using $mt tags( $i )

  $i = $i + 1
endw

print =============== step2
$i = 0
while $i < $tbNum
  $tb = $tbPrefix . $i
  sql insert into $tb values (now, $i , $i )

  $i = $i + 1000
endw

