system sh/stop_dnodes.sh
system sh/ip.sh -i 1 -s up
system sh/ip.sh -i 2 -s up

system sh/deploy.sh -n dnode1 -m 192.168.0.1 -i 192.168.0.1
system sh/deploy.sh -n dnode2 -m 192.168.0.1 -i 192.168.0.2

system sh/cfg.sh -n dnode1 -c dDebugFlag       -v 135
system sh/cfg.sh -n dnode1 -c mDebugFlag       -v 131
system sh/cfg.sh -n dnode1 -c sdbDebugFlag     -v 131
system sh/cfg.sh -n dnode1 -c rpcDebugFlag    -v 131
system sh/cfg.sh -n dnode1 -c cDebugFlag       -v 135
system sh/cfg.sh -n dnode1 -c monitorDebugflag -v 131
system sh/cfg.sh -n dnode1 -c httpDebugFlag    -v 135
system sh/cfg.sh -n dnode1 -c uDebugFlag       -v 135
system sh/cfg.sh -n dnode1 -c debugFlag        -v 135

system sh/cfg.sh -n dnode2 -c dDebugFlag       -v 135
system sh/cfg.sh -n dnode2 -c mDebugFlag       -v 131
system sh/cfg.sh -n dnode2 -c sdbDebugFlag     -v 131
system sh/cfg.sh -n dnode2 -c rpcDebugFlag    -v 131
system sh/cfg.sh -n dnode2 -c cDebugFlag       -v 135
system sh/cfg.sh -n dnode2 -c monitorDebugflag -v 131
system sh/cfg.sh -n dnode2 -c httpDebugFlag    -v 135
system sh/cfg.sh -n dnode2 -c uDebugFlag       -v 135
system sh/cfg.sh -n dnode2 -c debugFlag        -v 135

system sh/cfg.sh -n dnode1 -c commitLog        -v 0
system sh/cfg.sh -n dnode1 -c numOfTotalVnodes -v 8

system sh/cfg.sh -n dnode1 -c maxVnodeConnections -v 30000
system sh/cfg.sh -n dnode1 -c maxMgmtConnections  -v 30000
system sh/cfg.sh -n dnode1 -c maxMeterConnections -v 30000
system sh/cfg.sh -n dnode1 -c maxShellConns       -v 30000

system sh/cfg.sh -n dnode1 -c cacheBlockSize      -v 64000
system sh/cfg.sh -n dnode1 -c CacheNumOfBlocks      -v 2048

system sh/cfg.sh -n dnode1 -c averageCacheBlocks  -v 8
system sh/cfg.sh -n dnode1 -c monitor             -v 1
system sh/cfg.sh -n dnode1 -c monitorInterval     -v 1

system sh/cfg.sh -n dnode2 -c commitLog        -v 0
system sh/cfg.sh -n dnode2 -c numOfTotalVnodes -v 8

system sh/cfg.sh -n dnode2 -c maxVnodeConnections -v 30000
system sh/cfg.sh -n dnode2 -c maxMgmtConnections  -v 30000
system sh/cfg.sh -n dnode2 -c maxMeterConnections -v 30000
system sh/cfg.sh -n dnode2 -c maxShellConns       -v 30000

system sh/cfg.sh -n dnode2 -c cacheBlockSize      -v 64000
system sh/cfg.sh -n dnode2 -c CacheNumOfBlocks      -v 2048

system sh/cfg.sh -n dnode2 -c averageCacheBlocks  -v 8
system sh/cfg.sh -n dnode2 -c monitor             -v 1
system sh/cfg.sh -n dnode2 -c monitorInterval     -v 1

system sh/exec.sh -n dnode1 -s start

sql connect 
sleep 1000
system sh/exec.sh -n dnode2 -s start
sql create dnode 192.168.0.2
