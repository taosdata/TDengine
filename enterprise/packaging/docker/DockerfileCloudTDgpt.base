FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/var/lib/taos/taosanode/venv

RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update -y && \
    apt install -y curl \
                   vim \
                   gdb \
                   tmux \
                   valgrind \
                   jq \
                   net-tools \
                   locales \
                   tzdata \
                   netcat \
                   rsync \
                   gcc \
                   software-properties-common \
                   python3 \
                   python3-pip \
                   python3-dev \
                   python3.10-venv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /var/lib/taos/taosanode/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --upgrade pip && \
    pip install --no-cache-dir --ignore-installed blinker && \
    pip install --no-cache-dir \
                    numpy==1.26.4 \
                    pandas==1.5.0 \
                    scikit-learn \
                    outlier_utils \
                    statsmodels \
                    pyculiarity \
                    pmdarima \
                    flask \
                    matplotlib \
                    uwsgi \
                    transformers \
                    -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --upgrade keras -i https://pypi.tuna.tsinghua.edu.cn/simple

docker build --build-arg tdengine_pkgFile=TDengine-cloud-server-3.3.6.0.202503191128-Linux-x64.tar.gz   --build-arg tdengine_dirName=TDengine-cloud-server-3.3.6.0.202503191128   --build-arg tdgpt_pkgFile=TDengine-enterprise-anode-3.3.6.0.0319-Linux-x64.tar.gz   --build-arg tdgpt_dirName=TDengine-enterprise-anode-3.3.6.0.0319   -t "cloud_tdgpt:3.3.6.0"   -f DockerfileCloud   .
docker build --build-arg tdengine_pkgFile=TDengine-cloud-server-3.3.6.0.202503200747-Linux-x64.tar.gz   --build-arg tdengine_dirName=TDengine-cloud-server-3.3.6.0.202503200747   --build-arg tdgpt_pkgFile=TDengine-enterprise-anode-3.3.6.0.202503201532-Linux-x64.tar.gz --build-arg tdgpt_dirName=TDengine-enterprise-anode-3.3.6.0.202503201532 --build-arg nas_ip=192.168.1.131  -t "cloud_tdgpt:3.3.6.0.202503201539"   -f DockerfileCloud   .
TDengine-enterprise-anode-3.3.6.0.202503201532-Linux-x64.tar.gz
TDengine-cloud-server-3.3.6.0.202503200747-Linux-x64.tar.gz
