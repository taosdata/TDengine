FROM ubuntu:22.04

WORKDIR /root

ARG cpuType

RUN apt update && apt install -y curl vim gdb tmux valgrind jq net-tools locales tzdata netcat && apt-get clean && rm -rf /var/lib/apt/lists/

ENV TINI_VERSION v0.19.0
ENV TAOS_DISABLE_ADAPTER 1
ADD https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-${cpuType} /tini
ENV DEBIAN_FRONTEND=noninteractive
