FROM tdengine/tdengine-cloud-base

ARG pkgFile
ARG dirName

WORKDIR /root/
RUN echo ${pkgFile} && echo ${dirName}
COPY ${pkgFile} /root/
RUN tar -zxf ${pkgFile} && cd /root/${dirName}/ && /bin/bash install.sh -e no && cd /root && rm /root/${pkgFile} && rm -rf /root/${dirName} && locale-gen en_US.UTF-8

ENV LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/lib" \
    LC_CTYPE=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8
COPY ./run.sh /usr/bin/
COPY ./td_cluster_check /usr/bin/
COPY ./bin/* /usr/bin/

VOLUME [ "/var/lib/taos", "/var/log/taos" ]

ENTRYPOINT exec /usr/bin/run.sh
