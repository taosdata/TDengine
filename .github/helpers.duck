fn upx_run
  echo "UPX args: ${1} ${2}"
  fi = set ${1}
  if not is_file ${fi}
    echo "File ${fi} not found"
    exit 1
  end
  name = basename ${fi}
  fo = set ${2}
  if is_dir ${fo}
    fo = set "${fo}/${name}"
  end
  echo "Compressing ${fi} to ${fo} using UPX"

  os = os_family
  upx = which upx
  upx_dir = get_env "UPX_DIR"

  if is_empty ${upx}
    echo "UPX not found, use local upx in ${upx_dir}"
    cm_run_task upx-local
    upx = set "${upx_dir}/upx"
  else
    echo "UPX found: ${upx}"
  end

  output = exec ${upx} --version | grep 'upx 3'

  stdout = set ${output.stdout}

  if contains stdout "upx 3"
    echo "Use upx version: ${stdout}"
  else
    echo "UPX version not 3, use local upx in ${upx_dir}"
    cm_run_task upx-local
    upx = set "${upx_dir}/upx"
  end

  if is_file ${fo}
    echo "Remove file ${fo}"
    rm ${fo}
  end

  exec ${upx} -1 -f ${fi} -o ${fo}

  if not is_file ${fo}
    echo "UPX failed, fallback to copy"
    cp ${fi} ${fo}
    ver = exec ${fo} -V
    if not contains ${ver} "version"
      echo "UPX result file is not ok(-V: ${ver})"
      exit 1
    end
  else
    ver = exec ${fo} -V || true
    if not contains ${ver.stdout} "version"
      echo "UPX result file is not ok(-V: ${ver}), fallback to copy"
      cp ${fi} ${fo}
    end
  end
end
