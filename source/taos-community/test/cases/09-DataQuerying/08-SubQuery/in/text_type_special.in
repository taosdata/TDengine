use text_src_db;
SELECT ts, d FROM TEXT(ts TIMESTAMP, d DECIMAL(10,2)) VALUES ('2024-01-01 00:00:00', NULL) t_dec1 WHERE d IS NULL;
# dec2-old: no-ts DECIMAL SELECT (now rejected)
SELECT d FROM TEXT(d DECIMAL(10,2)) VALUES (3.14)(0)(99.99) t_dec2;
# dec2: DECIMAL with ts
SELECT ts, d FROM TEXT(ts TIMESTAMP, d DECIMAL(10,2)) VALUES ('2024-01-01 00:00:00', 3.14)('2024-01-02 00:00:00', 0)('2024-01-03 00:00:00', 99.99) t_dec2 ORDER BY ts;
# dec3-old: no-ts DECIMAL SUM (now rejected)
SELECT SUM(d) FROM TEXT(d DECIMAL(10,2)) VALUES (3.14)(0)(99.99) t_dec3;
# dec3: DECIMAL SUM with ts
SELECT SUM(d) FROM TEXT(ts TIMESTAMP, d DECIMAL(10,2)) VALUES ('2024-01-01 00:00:00', 3.14)('2024-01-02 00:00:00', 0)('2024-01-03 00:00:00', 99.99) t_dec3;
SELECT ts, d FROM TEXT(ts TIMESTAMP, d DECIMAL(38,10)) VALUES ('2024-01-01 00:00:00', 12345.6789) ('2024-01-02 00:00:00', NULL) t_dec4 ORDER BY ts;
# vb-old: no-ts VARBINARY SELECT (now rejected)
SELECT v FROM TEXT(v VARBINARY(64)) VALUES ('\x48454C4C4F')(NULL) t_vb;
# vb: VARBINARY with ts
SELECT ts, v FROM TEXT(ts TIMESTAMP, v VARBINARY(64)) VALUES ('2024-01-01 00:00:00', '\x48454C4C4F')('2024-01-02 00:00:00', NULL) t_vb ORDER BY ts;
