ARG PYTHON_BASE=python:3.12.12-slim-trixie
ARG PIP_INDEX_URL=

FROM ${PYTHON_BASE}
ARG PIP_INDEX_URL

COPY ./requirements_docker.txt /tmp/requirements_docker.txt
# gcc and libc-dev are runtime dependencies for compiling user models. Keep
# them in the lite image; only remove build artifacts unrelated to that workflow.
# Keep static .a libraries too: user C/Cython extensions can link against
# NumPy libnpymath.a and other package libraries. Import checks do not test linking.
# Removal requires a package-specific audit and a compilation/linking regression.
# Clean caches again after validation, covering both the main environment and venv.
# Preserve type stubs, legal notices and locales; drop other docs and manuals.
RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update -y && \
    apt-get install -y --no-install-recommends gcc libc-dev procps xz-utils && \
    PIP_INDEX_ARG="${PIP_INDEX_URL:+-i ${PIP_INDEX_URL}}" && \
    pip3 install --upgrade pip && \
    pip3 install --no-cache-dir -r /tmp/requirements_docker.txt ${PIP_INDEX_ARG} && \
    python3.12 -m venv --system-site-packages /var/lib/taos/taosanode/venv && \
    (find /usr/local/lib/python3.12 -depth -type d \( -name '__pycache__' -o \( \( -name 'test' -o -name 'tests' \) ! -path '*/include/*' \) \) -exec rm -rf {} + 2>/dev/null || true) && \
    python3.12 -B -c "import numpy, pandas, scipy, statsmodels, flask; import Cython, setuptools, wheel" && \
    python3.12 -B -m pip --version && \
    gcc --version && \
    (find /usr/local/lib/python3.12 /var/lib/taos/taosanode/venv -depth -type d \( -name '__pycache__' -o \( \( -name 'test' -o -name 'tests' \) ! -path '*/include/*' \) \) -exec rm -rf {} + 2>/dev/null || true) && \
    (find /usr/share/doc /usr/local/share/doc -type f \! -ipath '*license*' \! -ipath '*licence*' \! -ipath '*copyright*' \! -ipath '*copying*' \! -ipath '*notice*' -delete 2>/dev/null || true) && \
    rm -rf /usr/share/man /usr/local/share/man && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/requirements_docker.txt
