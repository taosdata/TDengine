ARG ARCH=amd64
FROM tdengine/tdgpt-env-${ARCH}:1.1 AS tdgpt

ARG pkgFile
ARG modelDlUrl

COPY ${modelDlUrl}/tdtsfm/taos.pth /var/lib/taos/taosanode/model/tdtsfm/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV INSTALL_VENV=False
COPY ${pkgFile} /tmp/
RUN set -eux; \
    TDGPT_INSTALL_DIR=/tmp/tdgpt-installer; \
    mkdir -p "${TDGPT_INSTALL_DIR}"; \
    tar -zxf /tmp/"${pkgFile}" --strip-components=1 --directory="${TDGPT_INSTALL_DIR}"; \
    cd "${TDGPT_INSTALL_DIR}"; \
    /bin/bash install.sh; \
    rm -rf /tmp/*

WORKDIR /root
EXPOSE 6035 6036 6037 6038 6039 6061 6062
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM tdengine/tdgpt-lite-env-${ARCH}:1.1 AS tdgpt_lite

ARG pkgFile

COPY entrypoint-lite.sh /usr/local/bin/entrypoint-lite.sh
RUN chmod +x /usr/local/bin/entrypoint-lite.sh

ENV INSTALL_VENV=False
COPY ${pkgFile} /tmp/
RUN set -eux; \
    TDGPT_INSTALL_DIR=/tmp/tdgpt-installer; \
    mkdir -p "${TDGPT_INSTALL_DIR}"; \
    tar -zxf /tmp/"${pkgFile}" --strip-components=1 --directory="${TDGPT_INSTALL_DIR}"; \
    cd "${TDGPT_INSTALL_DIR}"; \
    /bin/bash install.sh; \
    rm -rf /tmp/*

WORKDIR /root
EXPOSE 6035 6036 6037 6038 6039
ENTRYPOINT ["/usr/local/bin/entrypoint-lite.sh"]

FROM tdgpt AS tdgpt_full

COPY ${modelDlUrl}/timemoe/* \
    /var/lib/taos/taosanode/model/timemoe/
COPY --link ${modelDlUrl}/moment/* \
    /var/lib/taos/taosanode/model/moment/
COPY --link ${modelDlUrl}/moirai-small/* \
    /var/lib/taos/taosanode/model/moirai/
